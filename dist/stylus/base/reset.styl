/* @group Base */
html
  -webkit-text-size-adjust: 100%
  display: block
  font-family: sans-serif
  font-size: 100%
  text-rendering: optimizeLegibility
  @css {
    interpolate-size: allow-keywords;
  }

body
  background-color: var(--background-color)
  color: var(--foreground-color)
  font-family: 'Open Sans', sans-serif
  font-size: var(--gr-fsb)
  font-weight: 400
  line-height: 1.5
  word-wrap: break-word

// 2026 Core Accessibility: Global Focus Management
// Ensuring interactive elements have a clear :focus-visible style.
:focus-visible
  outline: 2px solid var(--focus-ring-color)
  outline-offset: 4px

// Global Accessibility: Motion Sensitivity
// Respect User Preferences for reduced motion.
@media (prefers-reduced-motion: reduce)
  *
    animation-duration: .01ms !important
    animation-iteration-count: 1 !important
    transition-duration: .01ms !important
    scroll-behavior: auto !important

a,
abbr,
address,
article,
aside,
audio,
b,
blockquote,
body,
button,
caption,
cite,
code,
dd,
del,
dfn,
dl,
dt,
em,
fieldset,
figure,
footer,
form,
h1,
h2,
h3,
h4,
h5,
h6,
header,
hgroup,
html,
i,
iframe,
img,
ins,
kbd,
label,
legend,
li,
mark,
menu,
nav,
object,
ol,
p,
pre,
q,
samp,
section,
select,
small,
span,
strong,
sub,
sup,
table,
tbody,
td,
tfoot,
th,
thead,
time,
tr,
ul,
var,
video
  box-sizing: border-box
  word-break: break-word

b,
strong
  font-weight: 700

code, kbd, pre, samp
    margin: 1.62rem 0

em, i
  font-style: italic

small
  font-size: var(--gr-fss)
  line-height: 1.3

p
  line-height: 1.5
  margin-bottom: 1.62rem
  max-width: 65ch // Optimal reading length

sup
  font-size: var(--gr-fss)
  top: .8em

sub
  bottom: -.8em
  font-size: var(--gr-fss)

// Accessibility Helper: Visually Hidden
// Hides content visually while keeping it available for screen readers.
.visually-hidden
  border: 0
  clip: rect(0 0 0 0)
  height: 1px
  margin: -1px
  overflow: hidden
  padding: 0
  position: absolute
  white-space: nowrap
  width: 1px

/* @end */
