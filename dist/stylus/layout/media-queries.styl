/* @group Media Queries */
//
// Five-step container ladder. Replaces the previous 38-step ladder
// which emitted ~3 KB of `.container { width: … }` rules without
// matching any sensible design system. The new sizes track the
// canonical mobile / tablet / laptop / desktop / wide-desktop
// viewports almost every team already designs for.
//
// Container queries are now baseline; for component-level
// responsiveness, prefer `@container (min-width: …)`. These rules
// only constrain the page-level `.container` so prose stays a
// readable measure.
//
// `:root { scroll-behavior: smooth }` used to be emitted INSIDE the
// loop, so 38 redundant copies. Now emitted once, gated behind
// prefers-reduced-motion.

.container
  margin: 0 auto
  width: 96%

@media (min-width: 30em) /* 480px */
  .container { max-width: 28rem }
@media (min-width: 48em) /* 768px */
  .container { max-width: 44rem }
@media (min-width: 64em) /* 1024px */
  .container { max-width: 60rem }
@media (min-width: 80em) /* 1280px */
  .container { max-width: 72rem }
@media (min-width: 96em) /* 1536px */
  .container { max-width: 84rem }

@media (prefers-reduced-motion: no-preference)
  :root
    scroll-behavior: smooth

/* @end */
