/* @group Colors */

:root
  --cl-primary: light-dark(oklch(.40 .2 250), oklch(.7 .16 250))
  --cl-secondary: light-dark(oklch(.38 .15 200), oklch(.65 .12 200))
  --cl-success: light-dark(oklch(.7 .2 140), oklch(.75 .15 140))
  --cl-info: light-dark(oklch(.85 .15 100), oklch(.88 .12 100))
  --cl-warning: light-dark(oklch(.8 .15 80), oklch(.82 .12 80))
  --cl-danger: light-dark(oklch(.55 .25 20), oklch(.65 .20 20))

  /* Background tints. Concrete light-dark() pairs (no relative-color
     syntax) so older Chromium / pa11y / WAVE can resolve them — the
     fallback to `transparent` was making `.alert-warning` and
     `.alert-danger` register 1.21:1 contrast in WCAG audits.
     Each tint pairs a near-white tint of the brand hue with a near-
     black tint at the same hue + chroma for dark mode. */
  --bg-primary: light-dark(oklch(.96 .03 250), oklch(.18 .04 250))
  --bg-secondary: light-dark(oklch(.96 .03 200), oklch(.18 .04 200))
  --bg-success: light-dark(oklch(.96 .03 140), oklch(.18 .04 140))
  --bg-info: light-dark(oklch(.96 .04 100), oklch(.18 .04 100))
  --bg-warning: light-dark(oklch(.96 .04 80), oklch(.18 .04 80))
  --bg-danger: light-dark(oklch(.96 .03 20), oklch(.18 .04 20))

  --cl-grey-100: light-dark(oklch(.98 .01 250), oklch(.15 .01 250))
  --cl-grey-200: light-dark(oklch(.9 .01 250), oklch(.25 .01 250))

/* Utility Classes */
.text-primary { color: var(--cl-primary); }
.text-secondary { color: var(--cl-secondary); }
.text-white { color: var(--cl-white); }
.text-black { color: var(--cl-black); }

.bg-primary { background-color: var(--bg-primary); }
.bg-surface { background-color: var(--cl-surface); }
.bg-black { background-color: var(--cl-black); }
.bg-white { background-color: var(--cl-white); }
.bg-soft { background-color: var(--cl-grey-100); }

/* @end */
