/* @group Variables */

  // Font Family
  $font = 'Open Sans'

  // Golden Ratios
  $gr         = 1.62 // The $gr (Golden Ratio) number, reduced to 1.62 due to the number-max-precision rule is used to produce a scale of numbers that is proportionally related.
  $gr-large   = round(1 / $gr, 2) // 0.62 ratio value
  $gr-small   = round(1 - $gr-large, 2) // 0.38 ratio value
  $gr-medium  = round((($gr-large + $gr-small) / 2), 2) // 0.5 ratio value

  // Golden Ratio Font Sizes (base,large,small,medium)
  $gr-fsb     = round($gr, 2)rem // 1.62rem - the $gr-fsb (Golden Ratio Font Size Base) is the scale’s root number.
  $gr-fsl     = round(2 * $gr-fsb * $gr-large, 2)rem //  2.01rem
  $gr-fsm     = round(2 * $gr-fsb * $gr-medium, 2)rem // 1.62rem
  $gr-fss     = round(2 * $gr-fsb * $gr-small, 2)rem //  1.23rem

  // Golden Ratio Headers (h1, h2, h3, h4, h5, h6)
  $gr-h1      = round($gr-fsb * ($gr ** 6), 2)rem // 29.07rem
  $gr-h2      = round($gr-fsb * ($gr ** 5), 2)rem // 17.97rem
  $gr-h3      = round($gr-fsb * ($gr ** 4), 2)rem // 11.1rem
  $gr-h4      = round($gr-fsb * ($gr ** 3), 2)rem // 6.86rem
  $gr-h5      = round($gr-fsb * ($gr ** 2), 2)rem // 4.24rem
  $gr-h6      = round($gr-fsb * ($gr ** 1), 2)rem // 2.62rem

  // Golden Ratio Line Heights
  $gr-lh      = round($gr-fsb * ($gr ** 1), 2)rem // 2.62rem
  $gr-lhl     = round($gr-fsl * ($gr ** 1), 2)rem // 3.25rem
  $gr-lhm     = round($gr-fsm * ($gr ** 1), 2)rem // 2.62rem
  $gr-lhs     = round($gr-fss * ($gr ** 1), 2)rem // 1.99rem

  // Golden Ratio Line Height Headers
  $gr-lh-h1   = round($gr-fsb * ($gr ** 2), 2)rem // 4.24rem
  $gr-lh-h2   = round($gr-fsb * ($gr ** 3), 2)rem // 6.86rem
  $gr-lh-h3   = round($gr-fsb * ($gr ** 4), 2)rem // 11.1rem
  $gr-lh-h4   = round($gr-fsb * ($gr ** 5), 2)rem // 17.97rem
  $gr-lh-h5   = round($gr-fsb * ($gr ** 6), 2)rem // 29.07rem
  $gr-lh-h6   = round($gr-fsb * ($gr ** 7), 2)rem // 47.04rem

// Link Colors
  :root
    --link-color: $blue
    --link-color-active: $red
    --link-color-focus: $red
    --link-color-hover: $red
    --link-color-visited: $purple

/* @end */

/* @group CSS Custom Properties Bridge (additive — non-breaking) */

// All Stylus $gr-* compile-time variables are mirrored here as runtime
// CSS custom properties so consumers can theme without recompiling
// Stylus. Stylus $vars are kept as the private compile-time aliases
// for the library's own internal use.
:root
  // Color scheme — opt the user agent into automatic light/dark form
  // controls and scrollbars. CSS Color Module Level 5, universally
  // supported in 2026.
  color-scheme: light dark

  // Golden ratio constants
  --gr: 1.62
  --gr-large: 0.62
  --gr-medium: 0.5
  --gr-small: 0.38

  // Golden ratio font sizes
  --gr-fsb: 1.62rem
  --gr-fsl: 2.01rem
  --gr-fsm: 1.62rem
  --gr-fss: 1.23rem

  // Golden ratio headers
  --gr-h1: 29.07rem
  --gr-h2: 17.97rem
  --gr-h3: 11.1rem
  --gr-h4: 6.86rem
  --gr-h5: 4.24rem
  --gr-h6: 2.62rem

  // Golden ratio line heights
  --gr-lh: 2.62rem
  --gr-lhl: 3.25rem
  --gr-lhm: 2.62rem
  --gr-lhs: 1.99rem

  // Focus ring color (WCAG 2.2 SC 2.4.11). Themeable.
  --focus-ring-color: var(--link-color, #007aff)

  // Surface tokens — light defaults
  --background-color: #ffffff
  --foreground-color: #000000

// Dark mode — opt-in via prefers-color-scheme. Consumers who set
// color-scheme: only light on a parent will not be affected.
@media (prefers-color-scheme: dark)
  :root
    --background-color: #0d0d10
    --foreground-color: #f5f5f7
    --focus-ring-color: var(--link-color, #4ea1ff)

/* @end */
