/* @group Paddings */

// Standard Golden Ratio Spacing Scale (Balanced)
$padding-spacings = {
  xs: .382rem,
  sm: .618rem,
  md: 1rem,
  lg: 1.618rem,
  xl: 2.618rem,
  xxl: 4.236rem
}

.p-0
  padding: 0 !important

for name, val in $padding-spacings
  .padding-{name}
    padding: val
  .pt-{name}
    padding-top: val
  .pb-{name}
    padding-bottom: val
  .px-{name}
    padding-left: val
    padding-right: val
  .py-{name}
    padding-top: val
    padding-bottom: val

/* @end */
