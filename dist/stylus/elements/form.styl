/* @group Input */
input[type=email], input[type=file], input[type=number], input[type=password], input[type=search], input[type=tel], input[type=text], input[type=url], select, textarea
  background: var(--background-color)
  border: 1px solid var(--cl-grey-300)
  border-radius: .375rem
  color: var(--foreground-color)
  display: block
  field-sizing: content // 2026 Native Auto-resize
  font-family: inherit
  font-size: 1rem
  line-height: 1.5
  margin: 0 0 1rem
  outline: 0
  padding: .625rem .75rem
  transition: border-color 150ms ease-out, box-shadow 150ms ease-out
  width: 100%

  &:hover
    border-color: var(--cl-grey-200)

  &:focus-visible
    border-color: var(--cl-black)
    outline: 2px solid var(--focus-ring-color)
    outline-offset: 2px

// 2026 Native Customizable Select
select
  appearance: base-select

@css {
  select::picker(select) {
    background-color: var(--cl-surface);
    border: 1px solid var(--cl-grey-200);
    border-radius: .5rem;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
    padding: .5rem;
  }
}

// Native Zero-JS Switch
input[type="checkbox"][role="switch"]
  @import "toggle"
  @media (forced-colors: active)
    &:focus-visible
      outline: 3px solid CanvasText
      outline-offset: 2px

