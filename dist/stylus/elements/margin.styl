/* @group Margins */

// Standard Golden Ratio Spacing Scale (rem-based)
// xs: ~0.38rem (small)
// sm: ~0.62rem (large)
// md: 1.62rem (base)
// lg: ~2.62rem (base * gr)
// xl: ~4.24rem (base * gr^2)

.margin-xs
  margin: var(--gr-small)rem
.margin-sm
  margin: var(--gr-large)rem
.margin-md
  margin: var(--gr-fsb)rem
.margin-lg
  margin: calc(var(--gr-fsb) * var(--gr))rem
.margin-xl
  margin: calc(var(--gr-fsb) * var(--gr) * var(--gr))rem

.margin-top-xs
  margin-top: var(--gr-small)rem
.margin-top-sm
  margin-top: var(--gr-large)rem
.margin-top-md
  margin-top: var(--gr-fsb)rem
.margin-top-lg
  margin-top: calc(var(--gr-fsb) * var(--gr))rem
.margin-top-xl
  margin-top: calc(var(--gr-fsb) * var(--gr) * var(--gr))rem

.margin-bottom-xs
  margin-bottom: var(--gr-small)rem
.margin-bottom-sm
  margin-bottom: var(--gr-large)rem
.margin-bottom-md
  margin-bottom: var(--gr-fsb)rem
.margin-bottom-lg
  margin-bottom: calc(var(--gr-fsb) * var(--gr))rem
.margin-bottom-xl
  margin-bottom: calc(var(--gr-fsb) * var(--gr) * var(--gr))rem

// Logical (start/end) — auto-flip in RTL.
.margin-start-xs
  margin-inline-start: var(--gr-small)rem
.margin-start-sm
  margin-inline-start: var(--gr-large)rem
.margin-start-md
  margin-inline-start: var(--gr-fsb)rem

.margin-end-xs
  margin-inline-end: var(--gr-small)rem
.margin-end-sm
  margin-inline-end: var(--gr-large)rem
.margin-end-md
  margin-inline-end: var(--gr-fsb)rem

.margin-auto
  margin: auto

/* @end */
