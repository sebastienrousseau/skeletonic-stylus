/* @group Lists */
table
  border: 1px solid var(--cl-black)
  border-collapse: collapse
  border-spacing: 0
  empty-cells: show
  padding-bottom: 25px

thead
  background-color: var(--cl-black)
  text-align: start
  vertical-align: top

td, th
  background-color: transparent
  border-inline-start: 1px solid var(--cl-black)
  border-block-width: 0
  border-inline-end-width: 0
  margin: 0
  overflow: visible
  padding: 6px 12px
  vertical-align: top

td
  color: var(--cl-black)

th
  color: var(--cl-white)

/* @end */
