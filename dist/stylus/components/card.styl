/* @group Cards */

.card
  background-color: var(--background-color)
  border: 1px solid var(--cl-grey-200)
  border-radius: 1.5rem
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, .05), 0 2px 4px -1px rgba(0, 0, 0, .03)
  padding: 2.62rem
  transition: transform .3s ease, box-shadow .3s ease

  &:hover
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, .05), 0 10px 10px -5px rgba(0, 0, 0, .02)
    transform: translateY(-2px)

  &.primary
    background-color: var(--bg-primary)
    border-color: var(--cl-primary)

.card-header
  display: flex
  flex-direction: column
  gap: .375rem
  margin-bottom: 1.5rem

.card-title
  font-size: 1.25rem
  font-weight: 600
  line-height: 1.25
  margin: 0

.card-description
  color: var(--cl-grey-600)
  font-size: .875rem
  line-height: 1.4
  margin: 0

.card-content
  font-size: .875rem
  line-height: 1.5

.card-footer
  align-items: center
  display: flex
  gap: .75rem
  margin-top: 1.5rem
  padding-top: 1rem

/* @end */
