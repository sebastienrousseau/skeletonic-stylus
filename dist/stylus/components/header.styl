/* @group Headings */

h1, h2, h3, h4, h5, h6,
.h1, .h2, .h3, .h4, .h5, .h6
  font-family: var(--font)
  font-kerning: normal
  font-variant-ligatures: common-ligatures
  margin-trim: block
  text-box-trim: trim-both
  text-rendering: optimizeLegibility

h1, .h1
  font-size: var(--gr-h1)
  font-weight: 700
  letter-spacing: -0.02em
  line-height: var(--gr-lh-h1)
  margin-bottom: 1.5rem

h2, .h2
  font-size: var(--gr-h2)
  font-weight: 700
  letter-spacing: -0.015em
  line-height: var(--gr-lh-h2)
  margin-bottom: 1.5rem

h3, .h3
  font-size: var(--gr-h3)
  font-weight: 600
  letter-spacing: -0.01em
  line-height: var(--gr-lh-h3)
  margin-bottom: 1rem

h4, .h4
  font-size: var(--gr-h4)
  font-weight: 600
  line-height: var(--gr-lh-h4)
  margin-bottom: 1rem

h5, .h5
  font-size: var(--gr-h5)
  font-weight: 600
  line-height: var(--gr-lh-h5)
  margin-bottom: 1rem

h6, .h6
  font-size: var(--gr-h6)
  font-weight: 600
  line-height: var(--gr-lh-h6)
  margin-bottom: 1rem

/* @end */
