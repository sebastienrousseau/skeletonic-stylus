/* @group Badge */
.badge
  align-items: center
  background: transparent
  border: 1px solid var(--cl-grey-300)
  border-radius: 9999px
  color: var(--foreground-color)
  display: inline-flex
  font-size: .75rem
  font-weight: 600
  justify-content: center
  line-height: 1
  min-height: 1.5rem
  padding: .25rem .625rem
  text-align: center
  vertical-align: middle
  white-space: nowrap

  // Brand badges use white text on the dark light-mode brand bg, but
  // the dark-mode brand value is LIGHTER and white on light fails AA
  // (2.66 : 1). Swap to black ink in dark mode via light-dark().
  &.primary
    background: var(--cl-primary)
    border-color: var(--cl-primary)
    color: light-dark(var(--cl-white), var(--cl-black))
  &.secondary
    background: var(--cl-secondary)
    border-color: var(--cl-secondary)
    color: light-dark(var(--cl-white), var(--cl-black))
  // Light status backgrounds (success green, warning amber, info
  // yellow) always need DARK text — white on these lands at 1.9–2.5:1.
  &.success
    background: var(--cl-success)
    border-color: var(--cl-success)
    color: var(--cl-black)
  &.warning
    background: var(--cl-warning)
    border-color: var(--cl-warning)
    color: var(--cl-black)
  &.danger,
  &.error
    background: var(--cl-danger)
    border-color: var(--cl-danger)
    color: light-dark(var(--cl-white), var(--cl-black))
  &.info
    background: var(--cl-info)
    border-color: var(--cl-info)
    color: var(--cl-black)
/* @end */
