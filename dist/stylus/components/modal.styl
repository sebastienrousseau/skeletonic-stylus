/* @group Modal */

// Pure CSS Modal using native <dialog>
dialog.modal
  background: var(--background-color)
  border: 0
  border-radius: .8rem
  box-shadow: 0 1rem 3rem rgba(0,0,0,0.2)
  color: var(--foreground-color)
  max-width: 90%
  opacity: 1
  padding: 2.62rem
  transition: opacity 0.5s ease, transform 0.5s ease, display 0.5s allow-discrete
  width: 50rem

  @starting-style
    opacity: 0
    transform: translateY(-20px)

  &::backdrop
    background: rgba(0, 0, 0, 0.5)
    backdrop-filter: blur(4px)
    opacity: 1
    transition: opacity 0.5s ease, display 0.5s allow-discrete

    @starting-style
      opacity: 0

  .modal-header
    border-bottom: .1rem solid var(--cl-grey-200)
    margin-bottom: 1.62rem
    padding-bottom: .8rem

  .modal-footer
    border-top: .1rem solid var(--cl-grey-200)
    display: flex
    gap: 1rem
    justify-content: flex-end
    margin-top: 1.62rem
    padding-top: 1.62rem

/* @end */
