/* @group Modal */

// Pure CSS Modal using native <dialog>
dialog.modal
  background: var(--background-color)
  border: 0
  border-radius: .8rem
  box-shadow: 0 1rem 3rem rgba(0,0,0,0.2)
  color: var(--foreground-color)
  max-width: 90%
  padding: 2.62rem
  width: 50rem

  &::backdrop
    background: rgba(0, 0, 0, 0.5)
    backdrop-filter: blur(4px)

  .modal-header
    border-bottom: .1rem solid var(--cl-grey-200)
    margin-bottom: 1.62rem
    padding-bottom: .8rem

  .modal-footer
    border-top: .1rem solid var(--cl-grey-200)
    display: flex
    gap: 1rem
    justify-content: flex-end
    margin-top: 1.62rem
    padding-top: 1.62rem

/* @end */
