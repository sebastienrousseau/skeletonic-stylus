/* @group Modern Motion Utilities (2026 Standards) */

// View Transitions API Utilities
// Enables seamless page transitions without JavaScript.
.view-transition-name
  for name in (root, header, main, footer, article, section)
    &-{name}
      view-transition-name: name

// Scroll-Driven Animation Utilities
// Native CSS scroll-timeline and view-timeline.
.scroll-timeline
  scroll-timeline-name: --page-scroll
  scroll-timeline-axis: block

.animate-on-scroll
  animation-timeline: view()
  animation-range: entry 10% cover 30%
  animation-fill-mode: both

// Entrance / Exit Defaults (High performance)
.fade-in
  animation: fade-in 0.3s ease-out both
.fade-out
  animation: fade-out 0.3s ease-in both

@keyframes fade-in
  from
    opacity: 0
  to
    opacity: 1

@keyframes fade-out
  from
    opacity: 1
  to
    opacity: 0

/* @end */
