/* @group Base Animation styles  */

  // Sensible defaults so every animation class works out of the box.
  // Consumers override only what they need (`animation-duration: 600ms`
  // etc) — no need to spell out every longhand.
  //
  //   - duration: 1s — industry standard for UI motion (continuous
  //     loops below override: 1.2s for spin, 6s for chameleon)
  //   - iteration-count: 1 (continuous loops below override to infinite)
  //   - fill-mode: both — "In" animations settle on their end state,
  //     "Out" on theirs, attention-grabbers reset (0% == 100%)
  //   - timing-function: ease-in-out (spin/chameleon override to linear)
  //
  // Each property is declared on disjoint selector lists so csso's
  // "drop duplicate value" pass never folds the rule out of existence.

  // animation-fill-mode: both — applies to every class.
  .bounce,
  .chameleonbackground,
  .chameleontext,
  .fadeIn,
  .fadeInDown,
  .fadeInLeft,
  .fadeInRight,
  .fadeInUp,
  .fadeOut,
  .fadeOutDown,
  .fadeOutLeft,
  .fadeOutRight,
  .fadeOutUp,
  .flash,
  .flip,
  .flipInHorizontal,
  .flipInVertical,
  .flipOutHorizontal,
  .flipOutVertical,
  .heartbeat,
  .jelly,
  .popIn,
  .popOut,
  .pulse,
  .rollIn,
  .rollOut,
  .rubberBand,
  .shake,
  .slideInDown,
  .slideInLeft,
  .slideInRight,
  .slideInUp,
  .slideOutDown,
  .slideOutLeft,
  .slideOutRight,
  .slideOutUp,
  .spinLeft,
  .spinRight,
  .swing,
  .tada,
  .vanishIn,
  .vanishOut,
  .wobble,
  .zoomIn,
  .zoomOut
    animation-fill-mode: both

  // animation-duration + animation-timing-function for one-shot
  // animations (the bulk). Disjoint from the spin/chameleon set below.
  .bounce,
  .fadeIn,
  .fadeInDown,
  .fadeInLeft,
  .fadeInRight,
  .fadeInUp,
  .fadeOut,
  .fadeOutDown,
  .fadeOutLeft,
  .fadeOutRight,
  .fadeOutUp,
  .flash,
  .flip,
  .flipInHorizontal,
  .flipInVertical,
  .flipOutHorizontal,
  .flipOutVertical,
  .heartbeat,
  .jelly,
  .popIn,
  .popOut,
  .pulse,
  .rollIn,
  .rollOut,
  .rubberBand,
  .shake,
  .slideInDown,
  .slideInLeft,
  .slideInRight,
  .slideInUp,
  .slideOutDown,
  .slideOutLeft,
  .slideOutRight,
  .slideOutUp,
  .swing,
  .tada,
  .vanishIn,
  .vanishOut,
  .wobble,
  .zoomIn,
  .zoomOut
    animation-duration: 1s
    animation-timing-function: ease-in-out

  // Continuous-loop animations — different duration + linear timing.
  .chameleonbackground,
  .chameleontext
    animation-duration: 6s
    animation-timing-function: linear

  .spinLeft,
  .spinRight
    animation-duration: 1.2s
    animation-timing-function: linear

  // animation-iteration-count: 1 for one-shots, infinite for continuous.
  .bounce,
  .fadeIn,
  .fadeInDown,
  .fadeInLeft,
  .fadeInRight,
  .fadeInUp,
  .fadeOut,
  .fadeOutDown,
  .fadeOutLeft,
  .fadeOutRight,
  .fadeOutUp,
  .flash,
  .flip,
  .flipInHorizontal,
  .flipInVertical,
  .flipOutHorizontal,
  .flipOutVertical,
  .jelly,
  .popIn,
  .popOut,
  .rollIn,
  .rollOut,
  .rubberBand,
  .shake,
  .slideInDown,
  .slideInLeft,
  .slideInRight,
  .slideInUp,
  .slideOutDown,
  .slideOutLeft,
  .slideOutRight,
  .slideOutUp,
  .swing,
  .tada,
  .vanishIn,
  .vanishOut,
  .wobble,
  .zoomIn,
  .zoomOut
    animation-iteration-count: 1

  .chameleonbackground,
  .chameleontext,
  .heartbeat,
  .pulse,
  .spinLeft,
  .spinRight
    animation-iteration-count: infinite

  // The animation is played in reverse direction (backwards)
  // All iterations of the animation are played in the reverse direction from the way they were specified. When an animation is played in reverse the timing functions are also reversed.
  .reverse
    animation-direction: reverse

  // The animation is played forwards first, then backwards
  // The animation cycle iterations that are odd counts are played in the normal direction, and the animation cycle iterations that are even counts are played in a reverse direction, thus reversing direction each cycle.
  .alternate
    animation-direction: alternate

  // The animation is played backwards first, then forwards
  // The animation cycle iterations that are odd counts are played in the reverse direction, and the animation cycle iterations that are even counts are played in a normal direction, again reversing direction each cycle.
  .alternate-reverse
    animation-direction: alternate-reverse

/* @end */
