/* @group Spin Left Animation */
@keyframes spinLeft
  from
    transform: rotate(0deg)

  to
    transform: rotate(360deg)

// Default value. The animation is played as normal (forwards)
.spinLeft
  animation-name: spinLeft
/* @end */
