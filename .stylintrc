{
  "blocks": false,
  "brackets": false,
  "colons": false,
  "colors": false,
  "commaSpace": false,
  "commentSpace": false,
  "cssLiteral": false,
  "depthLimit": false,
  "duplicates": false,
  "efficient": "always",
  "exclude": ["**/*.css"],
  "extendPref": false,
  "globalDupe": false,
  "groupOutputByFile": true,
  "indentPref": false,
  "leadingZero": "never",
  "maxErrors": false,
  "maxWarnings": false,
  "mixed": false,
  "mixins": [],
  "namingConvention": false,
  "namingConventionStrict": false,
  "noImportant": false,
  "parenSpace": false,
  "placeholders": false,
  "prefixVarsWithDollar": false,
  "quotePref": false,
  "reporterOptions": {
    "columns": ["lineData", "severity", "description", "rule"],
    "columnSplitter": "  ",
    "showHeaders": true,
    "truncate": true
  },
  "semicolons": false,
  "sortOrder": false,
  "stackedProperties": false,
  "trailingWhitespace": "never",
  "universal": false,
  "valid": false,
  "zeroUnits": false,
  "zIndexNormalize": false
}
