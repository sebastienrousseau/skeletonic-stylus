/* @group Variables */

  // Font Family (Apple-inspired system stack)
  $font = "SF Pro Display", "SF Pro Icons", "Helvetica Neue", "Helvetica", "Arial", sans-serif

  // Golden Ratios
  $gr         = 1.62
  $gr-large   = round(1 / $gr, 2)
  $gr-small   = round(1 - $gr-large, 2)
  $gr-medium  = round((($gr-large + $gr-small) / 2), 2)

  // Fluid Typography Scale (Apple-style Refinement)
  // formula: clamp(min, preferred, max)
  $gr-fsb     = clamp(1.0625rem, 0.5vw + 0.9rem, 1.25rem) // ~17px to 20px base
  $gr-fsl     = clamp(1.25rem, 1vw + 1rem, 1.5rem)
  $gr-fss     = clamp(0.75rem, 0.3vw + 0.7rem, 0.875rem)

  // Apple-grade Fluid Heading scale
  // Tighter tracking and responsive scaling
  $gr-h1      = clamp(2.5rem, 8vw, 4.5rem)
  $gr-h2      = clamp(2rem, 5vw, 3rem)
  $gr-h3      = clamp(1.5rem, 3vw, 1.875rem)
  $gr-h4      = clamp(1.25rem, 2vw, 1.5rem)
  $gr-h5      = clamp(1.125rem, 1vw, 1.25rem)
  $gr-h6      = clamp(1rem, 0.5vw + 0.9rem, 1.125rem)

  // Refined line heights
  $gr-lh-h1   = 1.1
  $gr-lh-h2   = 1.1
  $gr-lh-h3   = 1.2
  $gr-lh-h4   = 1.3
  $gr-lh-h5   = 1.4
  $gr-lh-h6   = 1.5

/* @end */

/* @group CSS Custom Properties Bridge */

:root
  color-scheme: light dark

  // Golden ratio constants
  --gr: 1.62

  // Fluid Font Sizes
  --gr-fsb: $gr-fsb
  --gr-fsl: $gr-fsl
  --gr-fss: $gr-fss

  // Fluid Heading sizes
  --gr-h1: $gr-h1
  --gr-h2: $gr-h2
  --gr-h3: $gr-h3
  --gr-h4: $gr-h4
  --gr-h5: $gr-h5
  --gr-h6: $gr-h6

  // Heading line heights
  --gr-lh-h1: $gr-lh-h1
  --gr-lh-h2: $gr-lh-h2
  --gr-lh-h3: $gr-lh-h3
  --gr-lh-h4: $gr-lh-h4
  --gr-lh-h5: $gr-lh-h5
  --gr-lh-h6: $gr-lh-h6

  // 2026 Color System: light-dark() integration
  --cl-white: oklch(1 0 0)
  --cl-black: oklch(0 0 0)
  --background-color: light-dark(oklch(1 0 0), oklch(0.05 0.01 250))
  --foreground-color: light-dark(oklch(0.11 0.01 250), oklch(0.95 0.01 250))
  --cl-surface: light-dark(oklch(0.98 0.01 250), oklch(0.12 0.02 250))

  --link-color: #0056b3
  --focus-ring-color: var(--link-color)

  // Breakpoints
  --bp-sm: 30em
  --bp-md: 48em
  --bp-lg: 64em
  --bp-xl: 80em
  --bp-xxl: 96em

/* @end */
