/* @group Variables */

  // Font Family
  $font = "Open Sans", system-ui, -apple-system, sans-serif

  // Golden Ratios
  $gr         = 1.62
  $gr-large   = round(1 / $gr, 2)
  $gr-small   = round(1 - $gr-large, 2)
  $gr-medium  = round((($gr-large + $gr-small) / 2), 2)

  // Fluid Typography Scale (2026 Standard)
  // Uses clamp() to smoothly transition between mobile and desktop sizes.
  // formula: clamp(min, preferred, max)
  $gr-fsb     = clamp(1.0rem, 0.5vw + 0.8rem, 1.62rem)
  $gr-fsl     = clamp(1.2rem, 1vw + 1rem, 2.01rem)
  $gr-fss     = clamp(0.8rem, 0.3vw + 0.7rem, 1.23rem)

  // Fluid Heading scale
  $gr-h1      = clamp(2.5rem, 5vw + 1rem, 5.3rem)
  $gr-h2      = clamp(2.0rem, 4vw + 1rem, 4.2rem)
  $gr-h3      = clamp(1.75rem, 3vw + 1rem, 3.3rem)
  $gr-h4      = clamp(1.5rem, 2vw + 1rem, 2.6rem)
  $gr-h5      = clamp(1.25rem, 1vw + 1rem, 2.0rem)
  $gr-h6      = clamp(1.0rem, 0.5vw + 0.9rem, 1.6rem)

  // Heading line heights
  $gr-lh-h1   = 1.2
  $gr-lh-h2   = 1.2
  $gr-lh-h3   = 1.3
  $gr-lh-h4   = 1.4
  $gr-lh-h5   = 1.5
  $gr-lh-h6   = 1.6

/* @end */

/* @group CSS Custom Properties Bridge */

:root
  color-scheme: light dark

  // Golden ratio constants
  --gr: 1.62

  // Fluid Font Sizes
  --gr-fsb: $gr-fsb
  --gr-fsl: $gr-fsl
  --gr-fss: $gr-fss

  // Fluid Heading sizes
  --gr-h1: $gr-h1
  --gr-h2: $gr-h2
  --gr-h3: $gr-h3
  --gr-h4: $gr-h4
  --gr-h5: $gr-h5
  --gr-h6: $gr-h6

  // Heading line heights
  --gr-lh-h1: $gr-lh-h1
  --gr-lh-h2: $gr-lh-h2
  --gr-lh-h3: $gr-lh-h3
  --gr-lh-h4: $gr-lh-h4
  --gr-lh-h5: $gr-lh-h5
  --gr-lh-h6: $gr-lh-h6

  // 2026 Color System: light-dark() integration
  // This eliminates the need for large @media (prefers-color-scheme) blocks.
  --cl-white: oklch(1 0 0)
  --cl-black: oklch(0 0 0)
  --background-color: light-dark(oklch(1 0 0), oklch(0.15 0.01 250))
  --foreground-color: light-dark(oklch(0 0 0), oklch(0.98 0.01 250))
  --cl-surface: light-dark(oklch(0.98 0.01 250), oklch(0.2 0.02 250))

  --link-color: light-dark(oklch(0.5 0.25 250), oklch(0.72 0.20 250))
  --focus-ring-color: var(--link-color)

  // Breakpoints
  --bp-sm: 30em
  --bp-md: 48em
  --bp-lg: 64em
  --bp-xl: 80em
  --bp-xxl: 96em

/* @end */
