/* @group Variables */

  // Font Family (Apple-inspired system stack)
  $font = "SF Pro Display", "SF Pro Icons", "Helvetica Neue", "Helvetica", "Arial", sans-serif

  // Golden Ratios
  $gr         = 1.62
  $gr-large   = round(1 / $gr, 2)
  $gr-small   = round(1 - $gr-large, 2)
  $gr-medium  = round((($gr-large + $gr-small) / 2), 2)

  // Fluid Typography Scale (Apple-style Refinement)
  // formula: clamp(min, preferred, max)
  $gr-fsb     = clamp(1.0625rem, .5vw + .9rem, 1.25rem) // ~17px to 20px base
  $gr-fsl     = clamp(1.25rem, 1vw + 1rem, 1.5rem)
  $gr-fss     = clamp(.75rem, .3vw + .7rem, .875rem)

  // Apple-grade Fluid Heading scale
  // Tighter tracking and responsive scaling
  $gr-h1      = clamp(2.5rem, 8vw, 4.5rem)
  $gr-h2      = clamp(2rem, 5vw, 3rem)
  $gr-h3      = clamp(1.5rem, 3vw, 1.875rem)
  $gr-h4      = clamp(1.25rem, 2vw, 1.5rem)
  $gr-h5      = clamp(1.125rem, 1vw, 1.25rem)
  $gr-h6      = clamp(1rem, .5vw + .9rem, 1.125rem)

  // Refined line heights
  $gr-lh-h1   = 1.1
  $gr-lh-h2   = 1.1
  $gr-lh-h3   = 1.2
  $gr-lh-h4   = 1.3
  $gr-lh-h5   = 1.4
  $gr-lh-h6   = 1.5

/* @end */

/* @group CSS Custom Properties Bridge */

:root
  color-scheme: light dark

  // Golden ratio constants
  --gr: 1.62

  /* ---------------------------------------------------------------------
   * Design tokens.
   *
   * Radius had grown to 21 distinct values across the library — `.35rem`,
   * `.375rem`, `.38rem`, `.3rem`, `.4rem` and `5px` all sat within a couple of
   * pixels of each other, which is accretion rather than a scale. Components
   * refer to these five instead, so the library's softness is one decision in
   * one place.
   * ------------------------------------------------------------------- */
  --radius-sm: .375rem    // 6px  — badges, inline code, small chips
  --radius-md: .625rem    // 10px — buttons, inputs, selects, menu items
  --radius-lg: .875rem    // 14px — cards, popovers, dropdowns, toasts
  --radius-xl: 1.25rem    // 20px — modals, sheets
  --radius-pill: 62.4375rem

  /* Control geometry. A control is 44px tall by default, the WCAG 2.5.8
   * enhanced target size, and the small and large steps stay either side of it
   * rather than each component inventing its own height. */
  --control-height-sm: 2.125rem   // 34px
  --control-height: 2.75rem       // 44px
  --control-height-lg: 3.25rem    // 52px
  --control-padding-x: 1.5rem
  --control-padding-x-sm: 1rem
  --control-padding-x-lg: 2rem

  /* The system UI stack. Matches the host platform's own interface font, which
   * is what makes an interface read as native rather than as a web page.
   * 'Open Sans' remains available through the optional fonts module. */
  --font-system: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif

  /* Elevation. Shadows had accreted to ten near-identical values; these four
   * steps replace them. Deliberately shallow — a heavy drop shadow is the
   * quickest way to make an interface look dated. */
  --shadow-sm: 0 1px 2px rgba(0, 0, 0, .05)
  --shadow-md: 0 1px 3px rgba(0, 0, 0, .1), 0 1px 2px rgba(0, 0, 0, .06)
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, .1), 0 4px 6px -4px rgba(0, 0, 0, .1)
  --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, .1), 0 8px 10px -6px rgba(0, 0, 0, .1)

  /* Motion. Eight durations were in use, and `.15s` and `150ms` were the same
   * value written two ways across 51 declarations. */
  --duration-fast: 150ms
  --duration-base: 200ms
  --duration-slow: 300ms
  --duration-slower: 400ms
  --ease-standard: cubic-bezier(.4, 0, .2, 1)
  --ease-out: cubic-bezier(.16, 1, .3, 1)

  // Fluid Font Sizes
  --gr-fsb: $gr-fsb
  --gr-fsl: $gr-fsl
  --gr-fss: $gr-fss

  // Fluid Heading sizes
  --gr-h1: $gr-h1
  --gr-h2: $gr-h2
  --gr-h3: $gr-h3
  --gr-h4: $gr-h4
  --gr-h5: $gr-h5
  --gr-h6: $gr-h6

  // Heading line heights
  --gr-lh-h1: $gr-lh-h1
  --gr-lh-h2: $gr-lh-h2
  --gr-lh-h3: $gr-lh-h3
  --gr-lh-h4: $gr-lh-h4
  --gr-lh-h5: $gr-lh-h5
  --gr-lh-h6: $gr-lh-h6

  // 2026 Color System: light-dark() integration
  --cl-white: oklch(1 0 0)
  --cl-black: oklch(0 0 0)
  --background-color: light-dark(oklch(1 0 0), oklch(.05 .01 250))
  --foreground-color: light-dark(oklch(.11 .01 250), oklch(.95 .01 250))
  --cl-surface: light-dark(oklch(.98 .01 250), oklch(.12 .02 250))

  // Body link colour — light-dark() so the link adapts to colour-
  // scheme. #0056b3 against white is 6.0 : 1; #66b2ff against the
  // dark-mode page bg (#0d0d10) is 7.4 : 1. Both clear AA.
  --link-color: light-dark(#0056b3, #66b2ff)
  --link-color-visited: light-dark(#5a3a8c, #b89bf0)
  --link-color-hover: light-dark(#003d7a, #99ccff)
  --link-color-focus: light-dark(#003d7a, #99ccff)
  --link-color-active: light-dark(#003d7a, #99ccff)
  --focus-ring-color: var(--link-color)

  // Breakpoints
  --bp-sm: 30em
  --bp-md: 48em
  --bp-lg: 64em
  --bp-xl: 80em
  --bp-xxl: 96em

/* @end */
