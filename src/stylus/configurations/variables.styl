/* @group Variables */

  // Font Family
  $font = 'Open Sans'

  // Golden Ratios
  $gr         = 1.62 // The $gr (Golden Ratio) number, reduced to 1.62 due to the number-max-precision rule is used to produce a scale of numbers that is proportionally related.
  $gr-large   = round(1 / $gr, 2) // 0.62 ratio value
  $gr-small   = round(1 - $gr-large, 2) // 0.38 ratio value
  $gr-medium  = round((($gr-large + $gr-small) / 2), 2) // 0.5 ratio value

  // Golden Ratio Font Sizes (base,large,small,medium)
  $gr-fsb     = round($gr, 2)rem // 1.62rem - the $gr-fsb (Golden Ratio Font Size Base) is the scale’s root number.
  $gr-fsl     = round(2 * $gr-fsb * $gr-large, 2)rem //  2.01rem
  $gr-fsm     = round(2 * $gr-fsb * $gr-medium, 2)rem // 1.62rem
  $gr-fss     = round(2 * $gr-fsb * $gr-small, 2)rem //  1.23rem

  // Heading scale — consumed by components/header.styl and exposed
  // as --gr-h1..--gr-h6 for runtime overrides. The earlier Φⁿ ladder
  // produced unusably large values (h1 ≈ 29rem); this scale uses a
  // ~1.27 ratio (musical minor-third), grounded so h6 ≥ body size.
  $gr-h1      = 5.3rem
  $gr-h2      = 4.2rem
  $gr-h3      = 3.3rem
  $gr-h4      = 2.6rem
  $gr-h5      = 2.0rem
  $gr-h6      = 1.6rem

  // Golden Ratio Line Heights
  $gr-lh      = round($gr-fsb * ($gr ** 1), 2)rem // 2.62rem
  $gr-lhl     = round($gr-fsl * ($gr ** 1), 2)rem // 3.25rem
  $gr-lhm     = round($gr-fsm * ($gr ** 1), 2)rem // 2.62rem
  $gr-lhs     = round($gr-fss * ($gr ** 1), 2)rem // 1.99rem

  // Heading line heights — paired with $gr-h1..$gr-h6 above. Tuned
  // for visual rhythm at each step rather than derived from Φⁿ.
  $gr-lh-h1   = 7.2rem
  $gr-lh-h2   = 5.8rem
  $gr-lh-h3   = 4.6rem
  $gr-lh-h4   = 3.6rem
  $gr-lh-h5   = 2.8rem
  $gr-lh-h6   = 2.3rem

// Link Colors
  :root
    --link-color: $blue
    --link-color-active: $red
    --link-color-focus: $red
    --link-color-hover: $red
    --link-color-visited: $purple

/* @end */

/* @group CSS Custom Properties Bridge (additive — non-breaking) */

// All Stylus $gr-* compile-time variables are mirrored here as runtime
// CSS custom properties so consumers can theme without recompiling
// Stylus. Stylus $vars are kept as the private compile-time aliases
// for the library's own internal use.
:root
  // Color scheme — opt the user agent into automatic light/dark form
  // controls and scrollbars. CSS Color Module Level 5, universally
  // supported in 2026.
  color-scheme: light dark

  // Golden ratio constants
  --gr: 1.62
  --gr-large: 0.62
  --gr-medium: 0.5
  --gr-small: 0.38

  // Golden ratio font sizes
  --gr-fsb: 1.62rem
  --gr-fsl: 2.01rem
  --gr-fsm: 1.62rem
  --gr-fss: 1.23rem

  // Heading sizes — runtime mirrors of $gr-h1..$gr-h6. Override on
  // any ancestor to retheme without recompiling Stylus.
  --gr-h1: 5.3rem
  --gr-h2: 4.2rem
  --gr-h3: 3.3rem
  --gr-h4: 2.6rem
  --gr-h5: 2.0rem
  --gr-h6: 1.6rem

  // Body line heights
  --gr-lh: 2.62rem
  --gr-lhl: 3.25rem
  --gr-lhm: 2.62rem
  --gr-lhs: 1.99rem

  // Heading line heights — paired with --gr-h1..--gr-h6 above.
  --gr-lh-h1: 7.2rem
  --gr-lh-h2: 5.8rem
  --gr-lh-h3: 4.6rem
  --gr-lh-h4: 3.6rem
  --gr-lh-h5: 2.8rem
  --gr-lh-h6: 2.3rem

  // Focus ring color (WCAG 2.2 SC 2.4.11). Themeable.
  --focus-ring-color: var(--link-color, #007aff)

  // Breakpoints
  --bp-sm: 30em   // 480px
  --bp-md: 48em   // 768px
  --bp-lg: 64em   // 1024px
  --bp-xl: 80em   // 1280px
  --bp-xxl: 96em  // 1536px

  // Surface tokens — light defaults
  --background-color: oklch(1 0 0)
  --foreground-color: oklch(0 0 0)

// Dark mode — opt-in via prefers-color-scheme. Consumers who set
// color-scheme: only light on a parent will not be affected.
@media (prefers-color-scheme: dark)
  :root
    --background-color: oklch(0.15 0.01 250)
    --foreground-color: oklch(0.98 0.01 250)
    --focus-ring-color: var(--link-color, oklch(0.7 0.2 250))
    // A separate "outline" tone for use by `.btn-outline` /
    // body-text links etc. on the dark surface — the regular
    // `--cl-primary` stays dark so white text on filled
    // `.button.primary` keeps clearing 4.5:1.
    --cl-primary-on-surface: oklch(0.78 0.16 250)
    --link-color: oklch(0.72 0.20 250)

/* @end */
