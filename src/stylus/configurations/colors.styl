/* @group Colors */

:root
  // 2026 Semantic Color Tokens using light-dark()
  // This allows the library to switch modes with zero extra CSS rules.
  --cl-primary: light-dark(oklch(0.40 0.2 250), oklch(0.7 0.16 250))
  --cl-secondary: light-dark(oklch(0.38 0.15 200), oklch(0.65 0.12 200))
  --cl-success: light-dark(oklch(0.7 0.2 140), oklch(0.75 0.15 140))
  --cl-info: light-dark(oklch(0.85 0.15 100), oklch(0.88 0.12 100))
  --cl-warning: light-dark(oklch(0.8 0.15 80), oklch(0.82 0.12 80))
  --cl-danger: light-dark(oklch(0.55 0.25 20), oklch(0.65 0.20 20))

  // Background tints (for alerts, cards, etc)
  --bg-primary: light-dark(oklch(0.96 0.02 250), oklch(0.18 0.04 250))
  --bg-secondary: light-dark(oklch(0.96 0.02 200), oklch(0.18 0.04 200))
  --bg-success: light-dark(oklch(0.94 0.03 140), oklch(0.18 0.04 140))
  --bg-info: light-dark(oklch(0.96 0.05 100), oklch(0.18 0.04 100))
  --bg-warning: light-dark(oklch(0.94 0.03 80), oklch(0.18 0.04 80))
  --bg-danger: light-dark(oklch(0.94 0.03 20), oklch(0.18 0.04 20))

  // Grey scale (using light-dark to invert automatically)
  --cl-grey-100: light-dark(oklch(0.98 0.01 250), oklch(0.15 0.01 250))
  --cl-grey-200: light-dark(oklch(0.9 0.01 250), oklch(0.25 0.01 250))
  --cl-grey-300: light-dark(oklch(0.8 0.01 250), oklch(0.35 0.01 250))
  --cl-grey-400: light-dark(oklch(0.7 0.01 250), oklch(0.45 0.01 250))
  --cl-grey-500: light-dark(oklch(0.6 0.01 250), oklch(0.55 0.01 250))
  --cl-grey-600: light-dark(oklch(0.5 0.01 250), oklch(0.65 0.01 250))
  --cl-grey-700: light-dark(oklch(0.4 0.01 250), oklch(0.75 0.01 250))
  --cl-grey-800: light-dark(oklch(0.3 0.01 250), oklch(0.85 0.01 250))
  --cl-grey-900: light-dark(oklch(0.2 0.01 250), oklch(0.95 0.01 250))

/* @end */
