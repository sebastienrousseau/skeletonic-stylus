/* @group Colors */

:root
  --cl-primary: light-dark(oklch(0.40 0.2 250), oklch(0.7 0.16 250))
  --cl-secondary: light-dark(oklch(0.38 0.15 200), oklch(0.65 0.12 200))
  --cl-success: light-dark(oklch(0.7 0.2 140), oklch(0.75 0.15 140))
  --cl-info: light-dark(oklch(0.85 0.15 100), oklch(0.88 0.12 100))
  --cl-warning: light-dark(oklch(0.8 0.15 80), oklch(0.82 0.12 80))
  --cl-danger: light-dark(oklch(0.55 0.25 20), oklch(0.65 0.20 20))

  @css {
    /* Background tints (using Relative Color Syntax - 2026 Standard) */
    --bg-primary: oklch(from var(--cl-primary) calc(l + 0.5) c h / 0.1);
    --bg-secondary: oklch(from var(--cl-secondary) calc(l + 0.5) c h / 0.1);
    --bg-success: oklch(from var(--cl-success) calc(l + 0.2) c h / 0.1);
  }

  --cl-grey-100: light-dark(oklch(0.98 0.01 250), oklch(0.15 0.01 250))
  --cl-grey-200: light-dark(oklch(0.9 0.01 250), oklch(0.25 0.01 250))

/* Utility Classes */
.text-primary { color: var(--cl-primary); }
.text-secondary { color: var(--cl-secondary); }
.text-white { color: var(--cl-white); }
.text-black { color: var(--cl-black); }

.bg-primary { background-color: var(--bg-primary); }
.bg-surface { background-color: var(--cl-surface); }
.bg-black { background-color: var(--cl-black); }
.bg-white { background-color: var(--cl-white); }
.bg-soft { background-color: var(--cl-grey-100); }

/* @end */
