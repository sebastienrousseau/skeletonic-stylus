/* @group Input OTP (2026 Standard) */

@keyframes otp-caret-blink
  0%,
  100%
    opacity: 1
  50%
    opacity: 0

.input-otp
  align-items: center
  display: inline-flex
  gap: .5rem
  user-select: none

.input-otp-group
  align-items: center
  display: inline-flex

  & > .input-otp-slot:first-child
    border-bottom-left-radius: .38rem
    border-top-left-radius: .38rem

  & > .input-otp-slot:last-child
    border-bottom-right-radius: .38rem
    border-top-right-radius: .38rem

  & > .input-otp-slot:not(:first-child)
    margin-left: -1px

.input-otp-slot
  align-items: center
  background-color: var(--background-color)
  border: 1px solid var(--cl-grey-300)
  color: var(--foreground-color)
  display: inline-flex
  font-size: 1.125rem
  font-variant-numeric: tabular-nums
  font-weight: 600
  height: 2.75rem
  justify-content: center
  position: relative
  transition: border-color var(--duration-fast) ease, box-shadow var(--duration-fast) ease
  width: 2.25rem

  &.active,
  &[data-active='true']
    border-color: var(--cl-primary)
    outline: 2px solid var(--cl-primary)
    outline-offset: -1px
    z-index: 2

.input-otp-caret
  animation: otp-caret-blink 1s infinite
  background-color: var(--cl-primary)
  height: 1.25rem
  pointer-events: none
  width: 2px

.input-otp-separator
  align-items: center
  color: var(--cl-grey-500)
  display: inline-flex
  font-size: 1rem
  justify-content: center
  padding: 0 .25rem

@media (prefers-reduced-motion: reduce)
  .input-otp-caret
    animation: none
