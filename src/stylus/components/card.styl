/* @group Cards */

.card
  background-color: var(--background-color)
  border: 1px solid var(--cl-border)
  border-radius: var(--radius-lg)
  box-shadow: 0 1px 3px 0 rgba(0, 0, 0, .05), 0 1px 2px -1px rgba(0, 0, 0, .05)
  padding: 1.5rem
  transition: transform var(--duration-base) ease, box-shadow var(--duration-base) ease

  &:hover
    box-shadow: 0 4px 6px -1px rgba(0, 0, 0, .07), 0 2px 4px -2px rgba(0, 0, 0, .05)

  &.primary
    background-color: var(--bg-primary)
    border-color: var(--cl-primary)

.card-header
  display: flex
  flex-direction: column
  gap: .375rem
  margin-bottom: 1.25rem

.card-title
  font-size: 1.125rem
  font-weight: 600
  letter-spacing: -.015em
  line-height: 1.25
  margin: 0

.card-description
  color: var(--cl-muted-foreground)
  font-size: .875rem
  line-height: 1.4
  margin: 0

.card-content
  font-size: .875rem
  line-height: 1.5

.card-footer
  align-items: center
  border-top: 1px solid var(--cl-border)
  display: flex
  gap: .75rem
  margin-top: 1.25rem
  padding-top: 1rem

/* @end */
