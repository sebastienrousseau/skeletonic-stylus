/* @group Headings */
// Sizes and line-heights are sourced from --gr-h1..--gr-h6 and
// --gr-lh-h1..--gr-lh-h6 (defined in configurations/variables.styl)
// so consumers can retheme without recompiling Stylus. The Stylus
// $gr-h* values seed the same numbers and act as the var() fallback.
$fontSizeFallback   = ($gr-h1 $gr-h2 $gr-h3 $gr-h4 $gr-h5 $gr-h6)
$lineHeightFallback = ($gr-lh-h1 $gr-lh-h2 $gr-lh-h3 $gr-lh-h4 $gr-lh-h5 $gr-lh-h6)
$mgBottom           = (4.4 2.7 1.7 1.1 .7 .4)

for index in (0..5)
    $level = index + 1
    h{$level},
    .h{$level}
        font-size: 'var(--gr-h%s, %s)' % ($level $fontSizeFallback[index])
        font-weight: 500
        letter-spacing: -.1rem
        line-height: 'var(--gr-lh-h%s, %s)' % ($level $lineHeightFallback[index])
        margin-bottom: $mgBottom[index]rem
/* @end */
