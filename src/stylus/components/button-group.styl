/* @group Button Group (2026 Standard) */

.button-group,
.btn-group
  display: inline-flex
  position: relative
  vertical-align: middle

  & > button,
  & > .button,
  & > a.button,
  & > [role='button']
    position: relative
    z-index: 1

    &:not(:first-child)
      border-bottom-left-radius: 0
      border-top-left-radius: 0
      margin-left: -1px

    &:not(:last-child)
      border-bottom-right-radius: 0
      border-top-right-radius: 0

    &:hover,
    &:active,
    &.active
      z-index: 2

    &:focus-visible
      z-index: 3

  // Vertical orientation
  &.button-group-vertical
    flex-direction: column

    & > button,
    & > .button,
    & > a.button,
    & > [role='button']
      margin-left: 0
      width: 100%

      &:not(:first-child)
        border-top-left-radius: 0
        border-top-right-radius: 0
        margin-top: -1px

      &:not(:last-child)
        border-bottom-left-radius: 0
        border-bottom-right-radius: 0
