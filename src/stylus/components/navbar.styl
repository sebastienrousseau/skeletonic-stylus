/* @group Navigation */

.navbar
  background: var(--cl-surface)
  box-shadow: none
  display: block
  height: 60px
  margin: 0 auto
  max-width: 100%
  overflow: hidden
  position: sticky
  top: 0
  width: 100%
  z-index: 10
  // Scroll-driven shadow animation
  animation: navbar-scroll both
  animation-timeline: scroll()
  animation-range: 0 100px

@keyframes navbar-scroll
  to
    box-shadow: 0 4px 20px -2px rgba(0, 0, 0, .1)
    // `color-mix(in oklch, ...)` is not parseable by Stylus, which is why this
    // was wrapped in `@css { }` — but that wrapper emitted a second, stray copy
    // at the top level, and a declaration where a selector is expected makes the
    // browser discard the rule that follows. `unquote()` passes the value
    // through literally and stays an ordinary declaration.
    background: unquote('color-mix(in oklch, var(--cl-surface), transparent 5%)')
    backdrop-filter: blur(10px)

  span
    display: none

.main
  display: block
  height: 100%
  margin: 0 auto
  margin-top: 60px

.mainInner
  display: table
  height: 100%
  position: absolute
  text-align: center
  width: 100%

  div
    display: table-cell
    font-size: 3em
    font-weight: bold
    letter-spacing: 1.25px
    vertical-align: middle

#sidebar
  background: var(--cl-white)
  height: 100%
  inset-inline-start: 0
  padding-top: 5 rem
  position: fixed
  // Slide off-screen toward the inline-start; flip in RTL.
  transform: translateX(-100vw)
  width: 100vw
  z-index: 1

[dir="rtl"] #sidebar
  transform: translateX(100vw)

.nav
  border-top: 1px solid var(--cl-black)
  margin: 0
  padding: 0

  li
    border-bottom: 1px solid var(--cl-black)
    color: var(--cl-white)
    cursor: pointer
    list-style: none
    margin-bottom: 0
    padding: round($gr, 1) rem
    text-transform: uppercase

    a
      color: var(--cl-black)
      cursor: pointer
      padding: round($gr, 1) rem
      text-decoration: none
      text-transform: uppercase
    &:hover
      background: var(--cl-black)
      cursor: pointer

      a
        color: var(--cl-white)
      & > ul
        display: block
    & > ul
      display: none
      & > li
        border-bottom: none
        margin: 0
        padding: round($gr, 1) rem

        a
          color: var(--cl-white)
          text-transform: none
          &:hover
            color: var(--cl-black)
        &:hover
          background var(--cl-white)

          a
            color: var(--cl-black)
  ul
    padding-inline-start: round($gr, 1) rem

input[type="checkbox"]:checked
  & ~ #sidebar
    transform: translateX(0)

// Scoped to the checkbox that actually drives the sidebar.
//
// This was a bare `input[type=checkbox]`, which hid *every* checkbox on the
// page — the library's own `.toggle` element included, and any plain checkbox
// in a consumer's markup. Specificity did not save them: this rule lives in
// `@layer skeletonic.components`, which is declared after
// `@layer skeletonic.elements`, and a later layer wins whatever the selector
// weight. `:has()` narrows it to the control that owns a `#sidebar` sibling.
input[type=checkbox]:has(~ #sidebar)
  box-sizing: border-box
  display: none
  transition: all var(--duration-slow)

.hamburger-toggle
  box-sizing: border-box
  cursor: pointer
  display: block
  height: 22px
  position: absolute
  top: 22px
  transition: all var(--duration-slow)
  width: 22px
  z-index: 99

  &-left
    inset-inline-start: 15px

  &-right
    inset-inline-end: 15px

.spinner
  background-color: var(--cl-black)
  box-sizing: border-box
  height: 3px
  position: absolute
  transition: all var(--duration-slow)
  width: 100%

.horizontal
  box-sizing: border-box
  float: left
  margin-top: 3px
  position: relative
  transition: all var(--duration-slow)

.diagonal
  &.part-1
    box-sizing: border-box
    float: inline-start
    position: relative
    transition: all var(--duration-slow)
  &.part-2
    box-sizing: border-box
    float: inline-start
    margin-top: 3px
    position: relative
    transition: all var(--duration-slow)

input[type=checkbox]:checked
  & ~ .hamburger-toggle
    & > .horizontal
      box-sizing: border-box
      opacity: 0
      transition: all var(--duration-slow)
    & > .diagonal
      &.part-1
        box-sizing: border-box
        margin-top: 8px
        transform: rotate(135deg)
        transition: all var(--duration-slow)
      &.part-2
        box-sizing: border-box
        margin-top: -9px
        transform: rotate(-135deg)
        transition: all var(--duration-slow)

/* @end */
