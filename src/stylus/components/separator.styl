/* @group Separator (2026 Standard) */

hr.separator,
div.separator,
[role='separator'].separator,
.separator
  background-color: var(--cl-grey-200)
  border: none
  flex-shrink: 0
  height: 1px
  margin: 1rem 0
  width: 100%

  // Vertical orientation
  &.separator-vertical,
  &[data-orientation='vertical']
    align-self: stretch
    height: auto
    margin: 0 1rem
    min-height: 1rem
    width: 1px

// Separator with middle text / label
.separator-label
  align-items: center
  color: var(--cl-grey-600)
  display: flex
  font-size: .75rem
  font-weight: 500
  letter-spacing: .05em
  margin: 1.25rem 0
  text-align: center
  text-transform: uppercase
  width: 100%

  &::before,
  &::after
    border-bottom: 1px solid var(--cl-grey-200)
    content: ''
    flex: 1

  &::before
    margin-right: .75rem

  &::after
    margin-left: .75rem
