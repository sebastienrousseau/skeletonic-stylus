/* @group Slider (2026 Standard) */

input[type='range'].slider,
.slider-input
  -webkit-appearance: none
  appearance: none
  background: transparent
  cursor: pointer
  display: block
  // WCAG 2.2 target size (minimum): the element box is the pointer target for a
  // range input, so every size variant is 1.5rem tall. The track and thumb keep
  // their own dimensions, so only the hit area grows, not the visual weight.
  height: 1.5rem
  margin: 0
  padding: 0
  width: 100%

  &:focus
    outline: none

  &:disabled
    cursor: not-allowed
    opacity: .5

  // Track WebKit
  &::-webkit-slider-runnable-track
    background-color: var(--cl-grey-200)
    border: none
    border-radius: var(--radius-pill)
    height: .5rem
    transition: background-color var(--duration-fast) ease
    width: 100%

  // Track Firefox
  &::-moz-range-track
    background-color: var(--cl-grey-200)
    border: none
    border-radius: var(--radius-pill)
    height: .5rem
    transition: background-color var(--duration-fast) ease
    width: 100%

  &::-moz-range-progress
    background-color: var(--cl-primary)
    border-radius: var(--radius-pill)
    height: .5rem

  // Thumb WebKit
  &::-webkit-slider-thumb
    -webkit-appearance: none
    appearance: none
    background-color: var(--background-color)
    border: 2px solid var(--cl-primary)
    border-radius: var(--radius-pill)
    box-shadow: var(--shadow-sm)
    height: 1.25rem
    margin-top: -.375rem
    transition: transform var(--duration-fast) ease, box-shadow var(--duration-fast) ease
    width: 1.25rem

  // Thumb Firefox
  &::-moz-range-thumb
    background-color: var(--background-color)
    border: 2px solid var(--cl-primary)
    border-radius: var(--radius-pill)
    box-shadow: var(--shadow-sm)
    height: 1.25rem
    transition: transform var(--duration-fast) ease, box-shadow var(--duration-fast) ease
    width: 1.25rem

  // Interactive states
  &:hover:not(:disabled)
    &::-webkit-slider-thumb
      box-shadow: unquote('0 0 0 4px color-mix(in oklch, var(--cl-primary) 15%, transparent)')
      transform: scale(1.08)

    &::-moz-range-thumb
      box-shadow: unquote('0 0 0 4px color-mix(in oklch, var(--cl-primary) 15%, transparent)')
      transform: scale(1.08)

  &:focus-visible
    &::-webkit-slider-thumb
      box-shadow: unquote('0 0 0 4px color-mix(in oklch, var(--cl-primary) 25%, transparent)')
      outline: 2px solid var(--cl-primary)
      outline-offset: 2px

    &::-moz-range-thumb
      box-shadow: unquote('0 0 0 4px color-mix(in oklch, var(--cl-primary) 25%, transparent)')
      outline: 2px solid var(--cl-primary)
      outline-offset: 2px

  // Small size
  &.sm
    height: 1.5rem

    &::-webkit-slider-runnable-track
      height: .25rem

    &::-moz-range-track,
    &::-moz-range-progress
      height: .25rem

    &::-webkit-slider-thumb
      height: 1rem
      margin-top: -.375rem
      width: 1rem

    &::-moz-range-thumb
      height: 1rem
      width: 1rem

  // Large size
  &.lg
    height: 1.5rem

    &::-webkit-slider-runnable-track
      height: .75rem

    &::-moz-range-track,
    &::-moz-range-progress
      height: .75rem

    &::-webkit-slider-thumb
      height: 1.5rem
      margin-top: -.375rem
      width: 1.5rem

    &::-moz-range-thumb
      height: 1.5rem
      width: 1.5rem

  // Color variants
  &.slider-success
    &::-moz-range-progress
      background-color: var(--cl-success)
    &::-webkit-slider-thumb,
    &::-moz-range-thumb
      border-color: var(--cl-success)

  &.slider-warning
    &::-moz-range-progress
      background-color: var(--cl-warning)
    &::-webkit-slider-thumb,
    &::-moz-range-thumb
      border-color: var(--cl-warning)

  &.slider-danger
    &::-moz-range-progress
      background-color: var(--cl-danger)
    &::-webkit-slider-thumb,
    &::-moz-range-thumb
      border-color: var(--cl-danger)

// Slider wrapper with label and value
.slider-group
  display: flex
  flex-direction: column
  gap: .5rem
  width: 100%

.slider-header
  align-items: center
  display: flex
  font-size: .875rem
  font-weight: 500
  justify-content: space-between

.slider-value
  font-variant-numeric: tabular-nums
  opacity: .75
