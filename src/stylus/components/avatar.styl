/* @group Avatar */

.avatar
  align-items: center
  background-color: var(--cl-grey-100)
  border-radius: var(--radius-pill)
  display: inline-flex
  flex-shrink: 0
  height: 2.5rem
  justify-content: center
  overflow: hidden
  position: relative
  user-select: none
  vertical-align: middle
  width: 2.5rem

  // Sizes
  &.sm
    font-size: .75rem
    height: 1.75rem
    width: 1.75rem

  &.lg
    font-size: 1.125rem
    height: 3.25rem
    width: 3.25rem

  &.xl
    font-size: 1.5rem
    height: 4rem
    width: 4rem

  // Square / Rounded variant
  &.rounded
    border-radius: var(--radius-lg)

  img,
  .avatar-image
    aspect-ratio: 1
    height: 100%
    object-fit: cover
    width: 100%

  .avatar-fallback
    align-items: center
    color: var(--foreground-color)
    display: flex
    font-size: inherit
    font-weight: 600
    height: 100%
    justify-content: center
    line-height: 1
    text-transform: uppercase
    width: 100%

  // Presence status indicator
  .avatar-status
    border: 2px solid var(--background-color)
    border-radius: var(--radius-pill)
    bottom: 0
    height: .75rem
    position: absolute
    right: 0
    width: .75rem

    &.online
      background-color: var(--cl-success)

    &.busy
      background-color: var(--cl-danger)

    &.away
      background-color: var(--cl-warning)

    &.offline
      background-color: var(--cl-grey-200)

// Avatar Group (stacked avatars)
.avatar-group
  display: inline-flex
  flex-direction: row-reverse
  justify-content: flex-end

  .avatar
    border: 2px solid var(--background-color)
    margin-left: -.75rem
    transition: transform var(--duration-base) ease

    &:hover
      transform: translateY(-2px)
      z-index: 1

    &:last-child
      margin-left: 0

/* @end */
