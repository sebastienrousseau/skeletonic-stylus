/* @group Sheet / Drawer (2026 Standard) */

// Native HTML5 <dialog> or [popover] sliding drawer
dialog.sheet,
[popover].sheet
  background-color: var(--background-color)
  border: none
  color: var(--foreground-color)
  height: 100%
  margin: 0
  max-height: 100%
  max-width: 100%
  padding: 1.5rem
  position: fixed
  transition: transform .3s ease, opacity .3s ease, display .3s allow-discrete
  width: 24rem
  z-index: 50

  // Default Right Sheet
  top: 0
  right: 0
  left: auto
  bottom: 0
  border-left: 1px solid var(--cl-grey-200)
  box-shadow: -5px 0 25px rgba(0, 0, 0, .1)

  @starting-style
    opacity: 0
    transform: translateX(100%)

  // Left Sheet
  &.sheet-left
    right: auto
    left: 0
    border-left: none
    border-right: 1px solid var(--cl-grey-200)
    box-shadow: 5px 0 25px rgba(0, 0, 0, .1)

    @starting-style
      opacity: 0
      transform: translateX(-100%)

  // Bottom Sheet
  &.sheet-bottom
    bottom: 0
    top: auto
    left: 0
    right: 0
    height: auto
    max-height: 80%
    width: 100%
    border-top: 1px solid var(--cl-grey-200)
    border-left: none
    border-radius: 1rem 1rem 0 0
    box-shadow: 0 -5px 25px rgba(0, 0, 0, .1)

    @starting-style
      opacity: 0
      transform: translateY(100%)

  // Top Sheet
  &.sheet-top
    top: 0
    bottom: auto
    left: 0
    right: 0
    height: auto
    max-height: 80%
    width: 100%
    border-bottom: 1px solid var(--cl-grey-200)
    border-left: none
    border-radius: 0 0 1rem 1rem
    box-shadow: 0 5px 25px rgba(0, 0, 0, .1)

    @starting-style
      opacity: 0
      transform: translateY(-100%)

  &::backdrop
    background: rgba(0, 0, 0, .5)
    backdrop-filter: blur(4px)
    opacity: 1
    transition: opacity .3s ease, display .3s allow-discrete

    @starting-style
      opacity: 0

  .sheet-header
    border-bottom: 1px solid var(--cl-grey-200)
    display: flex
    flex-direction: column
    gap: .5rem
    margin-bottom: 1.5rem
    padding-bottom: 1rem

  .sheet-title
    font-size: 1.25rem
    font-weight: 600
    margin: 0

  .sheet-description
    color: var(--foreground-color)
    font-size: .875rem
    margin: 0
    opacity: .7

  .sheet-footer
    border-top: 1px solid var(--cl-grey-200)
    display: flex
    gap: .75rem
    justify-content: flex-end
    margin-top: 1.5rem
    padding-top: 1rem

/* @end */
