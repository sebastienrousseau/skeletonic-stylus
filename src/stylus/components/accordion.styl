/* @group Accordion (2026 Standard) */

// Native Zero-JS Accordion
// Leveraging @interpolate-size for smooth height: auto transitions
details.accordion
  background: var(--cl-surface)
  border-radius: var(--radius-lg)
  border: 1px solid var(--cl-grey-200)
  margin-bottom: 1rem
  overflow: hidden
  // `interpolate-size: allow-keywords` on html is what makes a keyword height
  // animatable; the thing to transition is the height itself. This sat in an
  // `@css { }` block, which emitted a second, stray copy at the top level and
  // took the rule after it out with it.
  transition: height var(--duration-slow) ease

  &[open]
    summary
      border-bottom: 1px solid var(--cl-grey-200)
      &::after
        transform: rotate(180deg)

  summary
    align-items: center
    cursor: pointer
    display: flex
    font-weight: 600
    justify-content: space-between
    list-style: none
    padding: 1rem 1.5rem
    transition: background-color var(--duration-base) ease

    &::-webkit-details-marker
      display: none

    &:hover
      background-color: var(--cl-grey-100)

    &::after
      content: "↓"
      font-family: monospace
      transition: transform var(--duration-slow) ease

  .content
    padding: 1.5rem
    // Pre-flight for smooth transition
    height: 0
    opacity: 0
    transition: height var(--duration-slow) ease, opacity var(--duration-slow) ease, padding var(--duration-slow) ease

  &[open] .content
    height: auto
    opacity: 1

/* @end */
