/* @group Kbd */

kbd,
.kbd
  align-items: center
  background-color: var(--cl-surface)
  border: 1px solid var(--cl-grey-200)
  border-radius: .35rem
  box-shadow: inset 0 -1px 0 var(--cl-grey-200), 0 1px 1px rgba(0, 0, 0, .05)
  color: var(--foreground-color)
  display: inline-flex
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace
  font-size: .75rem
  font-weight: 600
  justify-content: center
  line-height: 1
  min-height: 1.5rem
  min-width: 1.5rem
  padding: .2rem .4rem
  user-select: none
  vertical-align: baseline
  white-space: nowrap

  // Sizes
  &.sm
    font-size: .675rem
    min-height: 1.25rem
    min-width: 1.25rem
    padding: .15rem .3rem

  &.lg
    font-size: .875rem
    min-height: 1.75rem
    min-width: 1.75rem
    padding: .25rem .5rem

/* @end */
