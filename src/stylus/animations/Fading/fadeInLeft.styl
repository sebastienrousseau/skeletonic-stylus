/* @group Fade In Left Transition */
@keyframes fadeInLeft
  0%
    opacity: 0
    transform: translateX(-16.18vh)
  100%
    opacity: 1
    transform: translateX(0)

// Set to apply a fade in left effect to an element.
.fadeInLeft
  animation-name: fadeInLeft
/* @end */
