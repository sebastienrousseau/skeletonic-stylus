/* @group Wiggle Animation (Motion UI) */
@keyframes wiggle
  0%,
  100%
    transform: rotate(0deg)
  20%
    transform: rotate(-7deg)
  40%
    transform: rotate(7deg)
  60%
    transform: rotate(-4deg)
  80%
    transform: rotate(4deg)

.wiggle
  animation-name: wiggle
/* @end */
