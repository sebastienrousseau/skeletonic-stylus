/* @group Hinge In From Left Animation (Motion UI) */
@keyframes hingeInFromLeft
  from
    opacity: 0
    transform: perspective(2000px) rotateY(90deg)

  to
    opacity: 1
    transform: perspective(2000px) rotateY(0)

.hingeInFromLeft
  animation-name: hingeInFromLeft
  transform-origin: left
/* @end */
