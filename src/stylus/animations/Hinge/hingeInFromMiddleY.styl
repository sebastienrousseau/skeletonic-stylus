/* @group Hinge In From Middle Y Animation (Motion UI) */
@keyframes hingeInFromMiddleY
  from
    opacity: 0
    transform: perspective(2000px) rotateY(-90deg)

  to
    opacity: 1
    transform: perspective(2000px) rotateY(0)

.hingeInFromMiddleY
  animation-name: hingeInFromMiddleY
  transform-origin: center
/* @end */
