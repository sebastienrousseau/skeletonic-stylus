/* @group Hinge In From Middle X Animation (Motion UI) */
@keyframes hingeInFromMiddleX
  from
    opacity: 0
    transform: perspective(2000px) rotateX(-90deg)

  to
    opacity: 1
    transform: perspective(2000px) rotateX(0)

.hingeInFromMiddleX
  animation-name: hingeInFromMiddleX
  transform-origin: center
/* @end */
