/* @group Hinge Out To Left Animation (Motion UI) */
@keyframes hingeOutToLeft
  from
    opacity: 1
    transform: perspective(2000px) rotateY(0)

  to
    opacity: 0
    transform: perspective(2000px) rotateY(90deg)

.hingeOutToLeft
  animation-name: hingeOutToLeft
  transform-origin: left
/* @end */
