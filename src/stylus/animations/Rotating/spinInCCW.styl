/* @group Spin In Counter-Clockwise Animation (Motion UI) */
@keyframes spinInCCW
  from
    opacity: 0
    transform: rotate(0deg) scale(.7)

  to
    opacity: 1
    transform: rotate(-360deg) scale(1)

.spinInCCW
  animation-name: spinInCCW
/* @end */
