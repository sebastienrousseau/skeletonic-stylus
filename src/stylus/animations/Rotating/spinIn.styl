/* @group Spin In Animation (Motion UI) */
@keyframes spinIn
  from
    opacity: 0
    transform: rotate(0deg) scale(.7)

  to
    opacity: 1
    transform: rotate(360deg) scale(1)

.spinIn
  animation-name: spinIn
/* @end */
