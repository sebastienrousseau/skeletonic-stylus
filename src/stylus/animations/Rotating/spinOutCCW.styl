/* @group Spin Out Counter-Clockwise Animation (Motion UI) */
@keyframes spinOutCCW
  from
    opacity: 1
    transform: rotate(0deg) scale(1)

  to
    opacity: 0
    transform: rotate(-360deg) scale(.7)

.spinOutCCW
  animation-name: spinOutCCW
/* @end */
