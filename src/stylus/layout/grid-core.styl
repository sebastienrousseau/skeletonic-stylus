/* @group Grid Core (2026 Standards) */

// Core Grid Container
.grid
  display: grid
  gap: var(--gr-fsb, 1rem)

  // Native Masonry (CSS Grid Level 3 - Final Standard)
  &.masonry
    display: grid-lanes // 2026 Native Standard
    grid-template-rows: masonry // Legacy Fallback
    masonry-auto-flow: packed

// Subgrid Support
.subgrid
  display: grid
  grid-template-columns: subgrid
  grid-template-rows: subgrid

/* @end */

/* @group Container Queries Core (Bento Layouts) */

.bento-container
  container-type: inline-size
  display: grid
  gap: 1rem
  grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr))

/* @end */
