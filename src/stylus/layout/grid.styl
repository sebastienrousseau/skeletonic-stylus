/* @group Grid (2026 Standards) */

// Core Grid Container
.grid
  display: grid
  gap: var(--gr-fsb, 1.62rem)

  // Native Masonry (CSS Grid Level 3)
  &.masonry
    grid-template-rows: masonry
    masonry-auto-flow: packed

// Subgrid Support
.subgrid
  display: grid
  grid-template-columns: subgrid
  grid-template-rows: subgrid

// 12-Column Scale
for i in (1..12)
  .grid-cols-{i}
    grid-template-columns: repeat(i, minmax(0, 1fr))

// Responsive Span (Mobile-first)
for i in (1..12)
  .col-span-{i}
    grid-column: span i / span i

/* @end */

/* @group Container Queries (Bento Layouts) */

// Bento Grid Support
// Allows components to adapt based on their parent container's width.
.bento-container
  container-type: inline-size
  display: grid
  gap: 1rem
  grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr))

@container (min-width: 40rem)
  .bento-item-featured
    grid-column: span 2
    grid-row: span 2

/* @end */
