/* @group Grid (2026 Standards) */

.grid
  display: grid
  gap: 2rem

  &.masonry
    grid-template-rows: masonry
    align-items: start

for i in (1..12)
  .grid-cols-{i}
    grid-template-columns: repeat(i, minmax(0, 1fr))

// Responsive overrides (Mobile-first)
@media (max-width: 48em)
  .grid-cols-2, .grid-cols-3
    grid-template-columns: 1fr

/* @end */
