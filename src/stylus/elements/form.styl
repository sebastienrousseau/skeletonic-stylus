/* @group Input */
input[type=email], input[type=file], input[type=number], input[type=password], input[type=search], input[type=tel], input[type=text], input[type=url], select, textarea
  background: var(--background-color)
  border: 1px solid var(--cl-grey-300)
  border-radius: .375rem
  color: var(--foreground-color)
  display: block
  font-family: inherit
  font-size: 1rem
  line-height: 1.5
  margin: 0 0 1rem 0
  outline: 0
  padding: .625rem .75rem
  transition: border-color 150ms ease-out, box-shadow 150ms ease-out
  width: 100%

  &:hover
    border-color: var(--cl-grey-200)

  &:focus-visible
    border-color: var(--cl-black)
    outline: 2px solid var(--focus-ring-color)
    outline-offset: 2px
  @media (forced-colors: active)
    &:focus-visible
      outline: 3px solid CanvasText
      outline-offset: 2px

.input-primary[type=email],
    .input-primary[type=file],
    .input-primary[type=number],
    .input-primary[type=password],
    .input-primary[type=search],
    .input-primary[type=tel],
    .input-primary[type=text],
    .input-primary[type=url],
    select.input-primary,
    textarea.input-primary
    background var(--bg-primary)
    border-color var(--cl-primary)
    color: #1a1a1a

