/* @group Input */
input[type=email], input[type=file], input[type=number], input[type=password], input[type=search], input[type=tel], input[type=text], input[type=url], textarea
  background-color: var(--background-color)
  border: 1px solid var(--cl-border)
  border-radius: var(--radius-md)
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, .05)
  color: var(--foreground-color)
  display: block
  font-family: inherit
  font-size: 1rem
  line-height: 1.5
  min-height: var(--control-height)
  outline: 0
  padding: .625rem 1rem
  transition: border-color var(--duration-fast) ease-out, box-shadow var(--duration-fast) ease-out
  width: 100%

  &::placeholder
    color: var(--cl-muted-foreground)

  &:hover
    border-color: var(--cl-grey-400)

  &:focus-visible
    border-color: var(--cl-ring)
    box-shadow: 0 0 0 1px var(--cl-ring)
    outline: 2px solid var(--cl-ring)
    outline-offset: 2px

  &:disabled
    cursor: not-allowed
    opacity: .5

textarea
  field-sizing: content
  min-height: 5rem
  resize: vertical

@css {
  select::picker(select) {
    background-color: var(--cl-surface);
    border: 1px solid var(--cl-grey-200);
    border-radius: var(--radius-lg);
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
    padding: .5rem;
  }
}

// Brand & Status Input Variants
.input-primary,
.input-secondary,
.input-success,
.input-info,
.input-warning,
.input-error
  color: light-dark(#1a1a1a, #f5f5f5)

.input-primary
  background: var(--bg-primary)
  border-color: var(--cl-primary)

.input-secondary
  background: var(--bg-secondary)
  border-color: var(--cl-secondary)

.input-success
  background: var(--bg-success)
  border-color: var(--cl-success)

.input-info
  background: var(--bg-info)
  border-color: var(--cl-info)

.input-warning
  background: var(--bg-warning)
  border-color: var(--cl-warning)

.input-error
  background: var(--bg-danger)
  border-color: var(--cl-danger)

/* @end */

