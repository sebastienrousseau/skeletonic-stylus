/* @group Input */
input[type=email], input[type=file], input[type=number], input[type=password], input[type=search], input[type=tel], input[type=text], input[type=url], select, textarea
  background: var(--background-color)
  border: 1px solid var(--cl-grey-300)
  border-radius: .375rem
  color: var(--foreground-color)
  display: block
  field-sizing: content // 2026 Native Auto-resize
  font-family: inherit
  font-size: 1rem
  line-height: 1.5
  margin: 0 0 1rem
  outline: 0
  padding: .625rem .75rem
  transition: border-color 150ms ease-out, box-shadow 150ms ease-out
  width: 100%

  &:hover
    border-color: var(--cl-grey-200)

  &:focus-visible
    border-color: var(--cl-black)
    outline: 2px solid var(--focus-ring-color)
    outline-offset: 2px

// 2026 Native Customizable Select
select
  appearance: base-select

@css {
  select::picker(select) {
    background-color: var(--cl-surface);
    border: 1px solid var(--cl-grey-200);
    border-radius: .5rem;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1);
    padding: .5rem;
  }
}

// Brand & Status Input Variants
.input-primary,
.input-secondary,
.input-success,
.input-info,
.input-warning,
.input-error
  color: light-dark(#1a1a1a, #f5f5f5)

.input-primary
  background: var(--bg-primary)
  border-color: var(--cl-primary)

.input-secondary
  background: var(--bg-secondary)
  border-color: var(--cl-secondary)

.input-success
  background: var(--bg-success)
  border-color: var(--cl-success)

.input-info
  background: var(--bg-info)
  border-color: var(--cl-info)

.input-warning
  background: var(--bg-warning)
  border-color: var(--cl-warning)

.input-error
  background: var(--bg-danger)
  border-color: var(--cl-danger)

/* @end */

