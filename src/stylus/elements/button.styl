/* @group Button */

-highlight($strength = .3)
  box-shadow: s("inset 0 " + round($gr px, 1) + " 0 %s", rgba(255, 255, 255, $strength))

button, .button, [type=submit]
  -highlight()
  background: var(--bg-disable)
  border:0
  cursor: pointer
  display: inline-block
  font-size: $gr-fsb rem
  margin-bottom: round($gr rem, 1)
  // Floor the touch target at WCAG 2.5.8 enhanced (44 px) without
  // forcing the chunky 27rem default that prevented .button-group
  // from laying out horizontally in any normal content column.
  min-width: 6rem
  min-height: 2.75rem
  padding: 0.75rem 1.5rem
  text-align: center
  text-decoration: none
  text-transform: uppercase
  transition-timing-function: ease-in-out
  user-select: none
  vertical-align: middle
  white-space: nowrap
  &:link, &:visited
    background: var(--cl-grey-900)
    color: var(--cl-white)
  &:active,
  &.active
    background: var(--cl-grey-1000)
    color: var(--cl-white)
    opacity: .85
    text-decoration: none
    transition: all 150ms linear
  &:hover
    opacity: .9
    text-decoration: none
    transition: all 150ms linear
  &:focus-visible
    background: var(--cl-grey-200)
    opacity: .7
    outline: 2px solid var(--focus-ring-color)
    outline-offset: 2px
    text-decoration: none
    transition: all 150ms linear
  @media (forced-colors: active)
    &:focus-visible
      outline: 3px solid CanvasText
      outline-offset: 2px
  &:disabled
    background: var(--cl-grey-700)
    color: var(--cl-white)
    cursor: not-allowed
    outline: 0
    transition: all 150ms linear
    user-select: none
  &.primary
    background: var(--cl-primary)
    color: var(--cl-white)
    cursor: pointer
    transition: all 150ms linear
    &:hover
      background-color: hsl(210, 100%, 32%)
      text-decoration: none
      transition: all 150ms linear
  &.secondary
    background: var(--cl-secondary)
    color: var(--cl-white)
    cursor: pointer
    transition: all 150ms linear
    &:hover
      background-color: hsl(195, 100%, 23%)
      text-decoration: none
      transition: all 150ms linear
  &.info
    background: var(--cl-info)
    color: var(--cl-white)
    cursor: pointer
    transition: all 150ms linear
    &:hover
      background-color: adjust(rgba(52, 199, 89, 1), 'lightness', -33%)
      text-decoration: none
      transition: all 150ms linear
  &.success
    background: var(--cl-success)
    color: var(--cl-white)
    cursor: pointer
    transition: all 150ms linear
    &:hover
      background-color: adjust(rgba(40, 167, 69, 1), 'lightness', -33%)
      text-decoration: none
      transition: all 150ms linear
  &.error
    background: var(--cl-danger)
    color: var(--cl-white)
    cursor: pointer
    transition: all 150ms linear
    &:hover
      background-color: adjust(rgba(255, 59, 48, 1), 'lightness', -33%)
      text-decoration: none
      transition: all 150ms linear
  &.warning
    background: var(--cl-warning)
    color: var(--cl-white)
    cursor: pointer
    transition: all 150ms linear
    &:hover
      background-color: adjust(rgba(255, 149, 0, 1), 'lightness', -33%)
      text-decoration: none
      transition: all 150ms linear
  &.link
    background: 0 0
    border-color: transparent
    box-shadow: none
    color: var(--link-color)
    cursor: pointer
    text-decoration: none
    transition: all 150ms linear
    &:visited
      color: var(--link-color-visited)
    &:active, &:hover
      color: var(--link-color-hover)
      text-decoration: underline
    &:focus-visible
      color: var(--link-color-focus)
      outline: 2px solid var(--focus-ring-color)
      outline-offset: 2px
    @media (forced-colors: active)
      &:focus-visible
        outline: 3px solid CanvasText
        outline-offset: 2px
// Modern flex layout — replaces a pre-flexbox letter-spacing: -.31em
// hack that left buttons stacking vertically because they couldn't
// negotiate space along the inline axis.
.button-group
  display: inline-flex
  flex-wrap: wrap
  gap: 0.5rem
  align-items: center
  & > .button,
  & > button
    margin-bottom: 0
// `.btn` is the shape system. It pairs with the `.button.<colour>`
// brand modifiers but ALSO ships a visible default — primary brand
// background, white text — so a bare `<button class="btn">` is a
// usable, on-brand button instead of an invisible browser default.
.btn
  align-items: center
  background: var(--cl-primary)
  border: 0
  border-radius: .3rem
  color: var(--cl-white)
  cursor: pointer
  display: inline-flex
  font-size: 1rem
  justify-content: center
  min-height: 2.75rem
  min-width: 2.75rem
  padding: 0.5rem 1rem
  position: relative
  text-align: center
  text-decoration: none
  text-transform: uppercase
  transition: all 150ms linear
  user-select: none
  vertical-align: middle
  white-space: nowrap
  z-index: 1
  &:hover
    opacity: .9
    text-decoration: none
  &-round
    border-radius: 50%
    padding: 0.5rem
    &:hover
      opacity: .9
  &-oval
    border-radius: 61.25rem
    min-width: 9rem
    &:hover
      opacity: .9
  &-outline
    background: transparent
    border: 2px solid var(--cl-primary)
    color: var(--cl-primary)
    &:hover
      background: var(--cl-primary)
      color: var(--cl-white)
      opacity: 1
// Full-width call-to-action variant. Use as a modifier on .button
// (e.g. <a class="button primary block">). Width was 98.7% which
// left a visible gap on the trailing edge — fixed to 100%.
.block
  border: 0
  display: block
  padding: 0.75rem 1.5rem
  width: 100%
button.primary-outline, .button.primary-outline, [type=submit].primary-outline
  background-color: var(--cl-white)
  border: 1px solid var(--cl-primary)
  color: var(--cl-primary)
button.primary-outline:hover, .button.primary-outline:hover, [type=submit].primary-outline:hover
  background-color: var(--bg-primary)
  color: var(--cl-primary)
  opacity: 1
  text-decoration: none
  transition: all 150ms linear
button.secondary-outline, .button.secondary-outline, [type=submit].secondary-outline
  background-color: var(--cl-white)
  border: 1px solid var(--cl-secondary)
  color: var(--cl-secondary)
button.secondary-outline:hover, .button.secondary-outline:hover, [type=submit].secondary-outline:hover
  background-color: var(--bg-secondary)
  color: var(--cl-secondary)
  opacity: 1
  text-decoration: none
  transition: all 150ms linear
button.success-outline, .button.success-outline, [type=submit].success-outline
  background-color: var(--cl-white)
  border: 1px solid var(--cl-success)
  color: var(--cl-success)
button.success-outline:hover, .button.success-outline:hover, [type=submit].success-outline:hover
  background-color: var(--bg-success)
  color: var(--cl-success)
  opacity: 1
  text-decoration: none
  transition: all 150ms linear
button.error-outline, .button.error-outline, [type=submit].error-outline
  background-color: var(--cl-white)
  border: 1px solid var(--cl-danger)
  color: var(--cl-danger)
button.error-outline:hover, .button.error-outline:hover, [type=submit].error-outline:hover
  background-color: var(--bg-danger)
  color: var(--cl-danger)
  opacity: 1
  text-decoration: none
  transition: all 150ms linear
button.warning-outline, .button.warning-outline, [type=submit].warning-outline
  background-color: var(--cl-white)
  border: 1px solid var(--cl-warning)
  color: var(--cl-warning)
button.warning-outline:hover, .button.warning-outline:hover, [type=submit].warning-outline:hover
  background-color: var(--bg-warning)
  color: var(--cl-warning)
  opacity: 1
  text-decoration: none
  transition: all 150ms linear

/* @end */
