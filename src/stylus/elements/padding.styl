/* @group Paddings */

// Standard Golden Ratio Spacing Scale (Balanced)
$padding-spacings = {
  xs: .382rem,
  sm: .618rem,
  md: 1rem,
  lg: 1.618rem,
  xl: 2.618rem,
  xxl: 4.236rem
}

.p-0
  padding: 0 !important

for name, val in $padding-spacings
  .padding-{name}
    padding: val
  .pt-{name}
    padding-top: val
  .pb-{name}
    padding-bottom: val
  .px-{name}
    padding-left: val
    padding-right: val
  .py-{name}
    padding-top: val
    padding-bottom: val

/* @end */

/* @group Gaps */

// Flex and grid gaps on the same golden-ratio scale as the padding and margin
// utilities. Without these there is no way to space the children of a `.flex`
// or grid container except an inline `style` attribute, which any consumer
// shipping a `style-src 'self'` Content Security Policy — this project's own
// showcase included — silently drops.
$gap-spacings = {
  xs: .382rem,
  sm: .618rem,
  md: 1rem,
  lg: 1.618rem,
  xl: 2.618rem,
  xxl: 4.236rem
}

.gap-0
  gap: 0

for name, val in $gap-spacings
  .gap-{name}
    gap: val
  .gap-x-{name}
    column-gap: val
  .gap-y-{name}
    row-gap: val

/* @end */
