/* @group Paddings */

// Standard Golden Ratio Spacing Scale (rem-based)
// xs: ~0.38rem (small)
// sm: ~0.62rem (large)
// md: 1.62rem (base)
// lg: ~2.62rem (base * gr)
// xl: ~4.24rem (base * gr^2)

.padding-xs
  padding: var(--gr-small)rem
.padding-sm
  padding: var(--gr-large)rem
.padding-md
  padding: var(--gr-fsb)rem
.padding-lg
  padding: calc(var(--gr-fsb) * var(--gr))rem
.padding-xl
  padding: calc(var(--gr-fsb) * var(--gr) * var(--gr))rem

.padding-top-xs
  padding-top: var(--gr-small)rem
.padding-top-sm
  padding-top: var(--gr-large)rem
.padding-top-md
  padding-top: var(--gr-fsb)rem
.padding-top-lg
  padding-top: calc(var(--gr-fsb) * var(--gr))rem
.padding-top-xl
  padding-top: calc(var(--gr-fsb) * var(--gr) * var(--gr))rem

.padding-bottom-xs
  padding-bottom: var(--gr-small)rem
.padding-bottom-sm
  padding-bottom: var(--gr-large)rem
.padding-bottom-md
  padding-bottom: var(--gr-fsb)rem
.padding-bottom-lg
  padding-bottom: calc(var(--gr-fsb) * var(--gr))rem
.padding-bottom-xl
  padding-bottom: calc(var(--gr-fsb) * var(--gr) * var(--gr))rem

// Logical (start/end) — auto-flip in RTL.
.padding-start-xs
  padding-inline-start: var(--gr-small)rem
.padding-start-sm
  padding-inline-start: var(--gr-large)rem
.padding-start-md
  padding-inline-start: var(--gr-fsb)rem

.padding-end-xs
  padding-inline-end: var(--gr-small)rem
.padding-end-sm
  padding-inline-end: var(--gr-large)rem
.padding-end-md
  padding-inline-end: var(--gr-fsb)rem

/* @end */
