/* @group Code */

// Base styles for code-like elements
code,
kbd,
pre,
samp
  font-family: "SF Mono", SFMono-Regular, Consolas, monospace
  font-size: .875em

// Naked code elements (inline by default)
code:not(.primary):not(.secondary):not(.tertiary):not(.success):not(.info):not(.warning):not(.error)
  background: transparent
  border: 0
  border-radius: .25rem
  box-shadow: none
  color: inherit
  display: inline
  overflow-wrap: break-word
  padding: .125rem .375rem
  word-break: break-word

// Preformatted blocks
pre
  background-color: transparent
  display: block
  margin-bottom: 0
  overflow: auto
  padding: $gr rem

  // When code is inside pre, it should behave as a block
  code
    display: block
    padding: 0
    white-space: pre-wrap

// Shared properties for pre and block code
pre,
code.primary,
code.secondary,
code.tertiary,
code.success,
code.info,
code.warning,
code.error
  direction: ltr
  page-break-inside: avoid
  text-align: left
  word-wrap: break-word

// Status variants (Block-level callouts)
code
  &.primary,
  &.secondary,
  &.tertiary,
  &.success,
  &.info,
  &.warning,
  &.error
    display: block
    padding: $gr rem
    border-radius: .4rem

  &.primary
    background: var(--bg-primary)
    border-block: .1rem solid var(--cl-primary)
    border-inline-start: .9rem solid var(--cl-primary)
    border-inline-end: .1rem solid var(--cl-primary)
    box-shadow: 0 12px 30px -9px var(--cl-grey-200)
    color: #1a1a1a

  &.secondary
    background: var(--bg-secondary)
    border-block: .1rem solid var(--cl-secondary)
    border-inline-start: .9rem solid var(--cl-secondary)
    border-inline-end: .1rem solid var(--cl-secondary)
    box-shadow: 0 12px 30px -9px var(--cl-grey-200)
    color: #1a1a1a

  &.tertiary
    background: var(--bg-tertiary)
    border-block: .1rem solid var(--cl-tertiary)
    border-inline-start: .9rem solid var(--cl-tertiary)
    border-inline-end: .1rem solid var(--cl-tertiary)
    box-shadow: 0 12px 30px -9px var(--cl-grey-200)
    color: #1a1a1a

  &.success
    background: var(--bg-success)
    border-block: .1rem solid var(--cl-success)
    border-color: var(--cl-success)
    border-inline-start: .9rem solid var(--cl-success)
    border-inline-end: .1rem solid var(--cl-success)
    box-shadow: 0 12px 30px -9px var(--cl-grey-200)
    color: #1a1a1a

  &.info
    background: var(--bg-info)
    border-block: .1rem solid var(--cl-info)
    border-inline-start: .9rem solid var(--cl-info)
    border-inline-end: .1rem solid var(--cl-info)
    box-shadow: 0 12px 30px -9px var(--cl-grey-200)
    color: #1a1a1a

  &.warning
    background: var(--bg-warning)
    border-block: .1rem solid var(--cl-warning)
    border-inline-start: .9rem solid var(--cl-warning)
    border-inline-end: .1rem solid var(--cl-warning)
    box-shadow: 0 12px 30px -9px var(--cl-grey-200)
    color: #1a1a1a

  &.error
    background: var(--bg-danger)
    border-block: .1rem solid var(--cl-danger)
    border-inline-start: .9rem solid var(--cl-danger)
    border-inline-end: .1rem solid var(--cl-danger)
    box-shadow: 0 12px 30px -9px var(--cl-grey-200)
    color: #1a1a1a

/* @end */
