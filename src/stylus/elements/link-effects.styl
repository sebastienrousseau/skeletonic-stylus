/* @group Link Effects */

// Common Link Effects Styles
//
// Each link must be a positioning context for its absolutely-positioned
// pseudo-element underline / bracket, and must clip the off-canvas
// starting state so the reveal is hidden until :hover.
for i in (1..12)
  .link-{i}
    background-color: transparent
    box-shadow: none
    display: inline-block
    padding: 10px
    position: relative
    transition: all .4s ease-out
    &:hover
        text-decoration: none

// Underline Left to Right
.link-1
    overflow: hidden
    &:before
        background: var(--link-color-focus)
        bottom: 0
        content: ''
        height: 3px
        inset-inline-start: 0
        position: absolute
        transform: translateX(-100%)
        transition: transform .4s ease-out
        width: 100%
    &:hover
        &:before
            transform: translateX(0)

// Underline Right to Left
.link-2
    overflow: hidden
    &:before
        background: var(--link-color-focus)
        bottom: 0
        content: ''
        height: 3px
        inset-inline-end: 0
        position: absolute
        transform: translateX(100%)
        transition: transform .4s ease-out
        width: 100%
    &:hover
        &:before
            transform: translateX(0)

// Underline Grow from Center
.link-3
    &:before
        background: var(--link-color-focus)
        bottom: 0
        content: ''
        height: 3px
        inset-inline-start: 0
        position: absolute
        transform: scaleX(0)
        transition: transform .4s ease-out
        width: 100%
    &:hover
        &:before
            transform: scaleX(1)

// Underline Shrink to Center
.link-4
    &:before
        background: var(--link-color-focus)
        bottom: 0
        content: ''
        height: 3px
        inset-inline-start: 0
        position: absolute
        transform: scaleX(1)
        transition: transform .4s ease-out
        width: 100%
    &:hover
        &:before
            transform: scaleX(0)

// Top/Bottom Left to Right
.link-5
    overflow: hidden
    &:before
        bottom: 0
        content: ''
        position: absolute
        transform: translateX(-100%)
        transition: transform .4s ease-out
    &:after
        content: ''
        position: absolute
        top: 0
        transform: translateX(-100%)
        transition: transform .4s ease-out

.link-5:before, .link-5:after
    background: var(--link-color-focus)
    height: 2px
    inset-inline-start: 0
    width: 100%

.link-5:hover:before, .link-5:hover:after
    transform: translateX(0)

// Top/Bottom Right to Left
.link-6
    overflow: hidden
    &:before
        bottom: 0
        content: ''
        position: absolute
        transform: translateX(100%)
        transition: transform .4s ease-out
    &:after
        content: ''
        position: absolute
        top: 0
        transform: translateX(100%)
        transition: transform .4s ease-out

.link-6:before, .link-6:after
    background: var(--link-color-focus)
    height: 2px
    inset-inline-start: 0
    width: 100%

.link-6:hover:before, .link-6:hover:after
    transform: translateX(0)

// Top/Bottom Grow from Center
.link-7
    overflow: hidden
    &:before
        bottom: 0
        content: ''
        position: absolute
        transform: scaleX(0)
        transition: transform .4s ease-out
    &:after
        content: ''
        position: absolute
        top: 0
        transform: scaleX(0)
        transition: transform .4s ease-out
    &:hover:before
        transform: scaleX(1)
    &:hover:after
        transform: scaleX(1)

.link-7:before, .link-7:after
    background: var(--link-color-focus)
    height: 2px
    inset-inline-start: 0
    width: 100%

// Top/Bottom Opposite Start
.link-8
    overflow: hidden
    &:before
        bottom: 0
        content: ''
        position: absolute
        transform: translateX(-100%)
        transition: transform .4s ease-out
    &:after
        content: ''
        position: absolute
        top: 0
        transform: translateX(100%)
        transition: transform .4s ease-out

.link-8:before, .link-8:after
    background: var(--link-color-focus)
    height: 2px
    inset-inline-start: 0
    width: 100%

.link-8:hover:before, .link-8:hover:after
    transform: translateX(0)

// Underline going Up
.link-9
    &:before
      background: var(--link-color-focus)
      content: ''
      height: 2px
      inset-inline-start: 0
      opacity: 0
      position: absolute
      top: 100%
      transform: translateY(20px)
      transition: opacity .4s, transform .4s
      width: 100%
    &:hover
        &:before
            opacity: 1
            transform: translateY(0)

// Underline going Down
.link-10
    &:before
      background: var(--link-color-focus)
      content: ''
      height: 2px
      inset-inline-start: 0
      opacity: 0
      position: absolute
      top: 100%
      transform: translateY(-15px)
      transition: opacity .4s, transform .4s
      width: 100%
    &:hover
        &:before
            opacity: 1
            transform: translateY(0)

// Expanding Brackets — `[ … ]` flares out on hover.
.link-11
    &:before,
    &:after
        color: var(--link-color-focus)
        content: ''
        position: absolute
        top: 50%
        transform: translateY(-50%)
        transition: transform .3s ease-out, content 0s
    &:hover:before
        content: '['
        transform: translateY(-50%) translateX(-15px)
    &:hover:after
        content: ']'
        transform: translateY(-50%) translateX(15px)

// Shrinking Brackets — `[ … ]` snap into place.
.link-12
    &:before,
    &:after
        color: var(--link-color-focus)
        content: ''
        position: absolute
        top: 50%
        transform: translateY(-50%) scaleX(0)
        transform-origin: center
        transition: transform .3s ease-out
    &:hover:before
        content: '['
        transform: translateY(-50%) translateX(-12px) scaleX(1)
    &:hover:after
        content: ']'
        transform: translateY(-50%) translateX(12px) scaleX(1)

// RTL — flip directional reveals so semantics ("from the start") are
// preserved when the inline axis is reversed.
[dir="rtl"]
    .link-1:before,
    .link-5:before,
    .link-5:after,
    .link-8:before
        transform: translateX(100%)
    .link-2:before,
    .link-6:before,
    .link-6:after,
    .link-8:after
        transform: translateX(-100%)
    .link-1:hover:before,
    .link-2:hover:before,
    .link-5:hover:before,
    .link-5:hover:after,
    .link-6:hover:before,
    .link-6:hover:after,
    .link-8:hover:before,
    .link-8:hover:after
        transform: translateX(0)
    .link-11:hover:before
        transform: translateY(-50%) translateX(15px)
    .link-11:hover:after
        transform: translateY(-50%) translateX(-15px)
    .link-12:hover:before
        transform: translateY(-50%) translateX(12px) scaleX(1)
    .link-12:hover:after
        transform: translateY(-50%) translateX(-12px) scaleX(1)

/* @end */
