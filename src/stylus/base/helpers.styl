/* @group Helpers */

.group:after
  clear: both
  content: ''
  display: table

/* Visibility & Interaction */
.hidden,
[hidden]
  display: none !important

.visually-hidden
  border: 0
  clip: rect(0 0 0 0)
  height: 1px
  margin: -1px
  overflow: hidden
  padding: 0
  position: absolute
  white-space: nowrap
  width: 1px

.overflow-hidden
  overflow: hidden

.pointer-events-none
  pointer-events: none

/* Flexbox & Grid Core */
.flex
  display: flex

.flex-column
  flex-direction: column

.flex-row
  flex-direction: row

.flex-wrap
  flex-wrap: wrap

.flex-between
  justify-content: space-between

.flex-center
  justify-content: center

.flex-middle
  align-items: center

.flex-1
  flex: 1

/* Alignment */
.text-center
  text-align: center

.text-left
  text-align: left

.text-right
  text-align: right

/* Dimensions & Scaling */
.mx-auto
  margin-left: auto
  margin-right: auto

.max-w-640
  max-width: 640px

.max-w-800
  max-width: 800px

.max-w-980
  max-width: 980px

.w-full
  width: 100%

.h-full
  height: 100%

.h-fixed-card
  height: 360px
  min-height: 360px

.w-240
  height: auto
  width: 240px

.w-120
  height: auto
  width: 120px

.w-40
  width: 40%

.w-70
  width: 70%

.size-32
  height: 32px
  width: 32px

.size-48
  height: 48px
  width: 48px

/* Positioning & Z-Index Scale */
.relative
  position: relative

.absolute
  position: absolute

.fixed
  position: fixed

.z-0
  z-index: 0

.z-10
  z-index: 10

.z-20
  z-index: 20

.z-30
  z-index: 30

.z-top
  z-index: 1000

/* Filters & States */
.opacity-10
  opacity: .1

.opacity-20
  opacity: .2

.opacity-60
  opacity: .6

.opacity-70
  opacity: .7

.grayscale
  filter: grayscale(1)

/* Typographic Excellence */
.bold
  font-weight: 700

.semibold
  font-weight: 600

.italic
  font-style: italic

.no-underline
  text-decoration: none !important

.underline
  text-decoration: underline !important

.tracking-tight
  letter-spacing: -.02em

.antialiased
  -moz-osx-font-smoothing: grayscale
  -webkit-font-smoothing: antialiased

/* Border Radius */
.radius
  border-radius: var(--radius-xl)

.radius-xl
  border-radius: var(--radius-xl)

.radius-full
  border-radius: var(--radius-pill)

/* @end */
