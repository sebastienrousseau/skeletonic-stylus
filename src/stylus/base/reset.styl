  box-sizing: border-box
  word-break: break-word

b,
strong
  font-weight: 700

code, kbd, pre, samp
    margin: 1.62rem 0

em, i
  font-style: italic

small
  font-size: var(--gr-fss)
  line-height: 1.3

p
  line-height: 1.5
  margin-bottom: 1.62rem
  max-width: 65ch // Optimal reading length

sup
  font-size: var(--gr-fss)
  top: .8em

sub
  bottom: -.8em
  font-size: var(--gr-fss)

// Accessibility Helper: Visually Hidden
// Hides content visually while keeping it available for screen readers.
.visually-hidden
  border: 0
  clip: rect(0 0 0 0)
  height: 1px
  margin: -1px
  overflow: hidden
  padding: 0
  position: absolute
  white-space: nowrap
  width: 1px

/* @end */
