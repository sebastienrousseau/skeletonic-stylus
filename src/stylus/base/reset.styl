/* @group Base */
html
  -webkit-text-size-adjust: 100%
  display: block
  font-family: sans-serif
  font-size: 100%
  text-rendering: optimizeLegibility
  // Written as a plain declaration. Inside an `@css { }` block Stylus emitted it
  // twice: once correctly inside `html`, and once as a stray declaration at the
  // top level. A declaration where a selector is expected puts the parser into
  // error recovery, which discards everything up to and past the next block — so
  // the entire `body` rule below it was being thrown away, taking the library's
  // base font-size, colours and line-height with it.
  interpolate-size: allow-keywords

body
  background-color: var(--background-color)
  color: var(--foreground-color)
  // The host platform's own interface font. 'Open Sans' was hardcoded here even
  // though the library ships it as an optional module, so the core could not be
  // used without it and no consumer could opt out. Import the fonts module to
  // get Open Sans back.
  font-family: var(--font-system)
  font-size: var(--gr-fsb)
  font-weight: 400
  line-height: 1.5
  word-wrap: break-word

// 2026 Core Accessibility: Global Focus Management
// Ensuring interactive elements have a clear :focus-visible style.
:focus-visible
  outline: 2px solid var(--focus-ring-color)
  outline-offset: 4px

// Global Accessibility: Motion Sensitivity
// Respect User Preferences for reduced motion.
@media (prefers-reduced-motion: reduce)
  *
    animation-duration: .01ms !important
    animation-iteration-count: 1 !important
    transition-duration: .01ms !important
    scroll-behavior: auto !important

