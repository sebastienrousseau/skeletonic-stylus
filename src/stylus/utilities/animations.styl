/* @group Modern Motion & States (2026) */

// View Transitions API
// A parenthesised list is not Stylus `for` syntax; the names go in a list
// variable. This file had never been compiled — nothing imported it — so the
// error had never surfaced.
$view-transition-names = root header main footer article section

.view-transition-name
  for name in $view-transition-names
    &-{name}
      view-transition-name: unquote(name)

// Scroll-Driven Animations
.scroll-timeline
  scroll-timeline-name: --page-scroll
  scroll-timeline-axis: block

.animate-on-scroll
  animation-timeline: view()
  animation-range: entry 10% cover 30%
  animation-fill-mode: both


// Anchor Positioning Utilities (Native Floating UI)
// tether an element to an anchor without JavaScript.
.anchor-tether
  position: absolute
  position-anchor: --anchor-target
  // Both properties were renamed during the CSS Anchor Positioning spec's
  // development: `inset-area` became `position-area`, and
  // `position-try-options` became `position-try-fallbacks`. Under the old
  // names the browser dropped them at parse time, so the tether never
  // positioned and never flipped. Nothing noticed, because this file was not
  // in any bundle.
  position-area: block-end center
  position-try-fallbacks: flip-block, flip-inline

.anchor-target
  anchor-name: --anchor-target

/* Modern Easing Functions (2026 Spring Physics) */
:root
  // Spring: stiffness=100, damping=10
  --ease-spring-bout: linear(0, 0.47, 0.82, 1.04, 1.13, 1.14, 1.09, 1.03, 0.98, 0.96, 0.97, 1)
  // Spring: stiffness=100, damping=20
  --ease-spring-elastic: linear(0, 0.36, 0.63, 0.82, 0.95, 1.02, 1.05, 1.05, 1.03, 1.01, 1, 1)
  --ease-out-expo: cubic-bezier(.16, 1, .3, 1)

/* @end */
