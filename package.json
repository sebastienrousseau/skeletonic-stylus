{
  "name": "@sebastienrousseau/skeletonic-stylus",
  "version": "2.0.0",
  "description": "A lightweight, intuitive, accessible and ultra-responsive Stylus Library to streamline your digital and mobile web development needs. Proudly made with Stylus ❤",
  "keywords": [
    "css",
    "mit-license",
    "open-source",
    "preprocessor",
    "skeletonic-css",
    "skeletonic-stylus",
    "stylus-css",
    "stylus-mixin",
    "stylus"
  ],
  "main": "stylus/skeletonic.styl",
  "style": "css/core/skeletonic.min.css",
  "sass": "stylus/skeletonic.styl",
  "repository": "git+https://github.com/sebastienrousseau/skeletonic-stylus.git",
  "author": {
    "name": "Sebastien Rousseau",
    "email": "hello@skeletonic.io",
    "url": "https://skeletonic.io"
  },
  "license": "(MIT OR Apache-2.0)",
  "bugs": {
    "url": "https://github.com/sebastienrousseau/skeletonic-stylus/issues"
  },
  "homepage": "https://docs.skeletonic.io",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "autoupdate": {
    "source": "git",
    "target": "git+https://github.com/sebastienrousseau/skeletonic-stylus.git",
    "fileMap": [
      {
        "basePath": "dist",
        "files": [
          "**/*"
        ]
      }
    ]
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "// Build": " --- Build Scripts --- ",
    "build": "pnpm run dev:generate:skeletonic-library && pnpm run dev:copy:stylus && pnpm run dev:copy:index && pnpm run dev:copy:readme && pnpm run dev:copy:cli && pnpm run dev:emit:sbom && pnpm run dev:emit:dist-package && pnpm run dev:size && pnpm run dev:a11y && npm pack ./dist",
    "verify": "node ./scripts/verify-release.mjs",
    "verify:cdn": "node ./scripts/verify-cdn.mjs",
    "dev:emit:dist-package": "node ./scripts/emit-dist-package.mjs",
    "dev:emit:sbom": "node ./scripts/emit-sbom.mjs",
    "dev:wrap:cascade-layers": "node ./scripts/wrap-cascade-layers.mjs dist/css/core/skeletonic.css dist/css/core/skeletonic.min.css dist/css/core/skeletonic-ui.css dist/css/core/skeletonic-ui.min.css dist/css/animations/skeletonic-animations.css dist/css/animations/skeletonic-animations.min.css dist/css/fonts/skeletonic-fonts.css dist/css/fonts/skeletonic-fonts.min.css dist/css/hebrew-fonts/skeletonic-hebrew-fonts.css dist/css/hebrew-fonts/skeletonic-hebrew-fonts.min.css dist/css/palettes/material/skeletonic-material.css dist/css/palettes/material/skeletonic-material.min.css dist/css/palettes/tachyons/skeletonic-tachyons.css dist/css/palettes/tachyons/skeletonic-tachyons.min.css dist/css/palettes/websafe/skeletonic-websafe.css dist/css/palettes/websafe/skeletonic-websafe.min.css",
    "dev:size": "size-limit",
    "dev:a11y": "node ./scripts/a11y-test.mjs",
    "// Skeletonic CSS Library": " --- Development Scripts --- ",
    "dev:generate:skeletonic-library": "rimraf dist && pnpm run dev:generate:animations && pnpm run dev:generate:fonts && pnpm run dev:generate:hebrew-fonts && pnpm run dev:generate:material && pnpm run dev:generate:tachyons && pnpm run dev:generate:websafe && pnpm run dev:generate:skeletonic && pnpm run dev:generate:skeletonic-ui && pnpm run dev:wrap:cascade-layers && pnpm run dev:filesizes:package",
    "// Skeletonic CSS Animations": " --- Development Scripts --- ",
    "dev:generate:animations": "pnpm run dev:format:animations && pnpm run dev:create:animations && pnpm run dev:prettier:animations && pnpm run dev:autoprefixer:animations && pnpm run dev:minimize:animations && pnpm run dev:filesizes:animations",
    "dev:format:animations": "mkdir -p debug && npx stylus-supremacy format ./src/stylus/animations/**/*.styl --options .stylelintrc.json > ./debug/animations-output.log",
    "dev:lint:animations": "npx stylint ./src/stylus/animations/**/*.styl --strict --fix",
    "dev:create:animations": "stylus ./src/stylus/animations/_contents.styl -o ./dist/css/animations/skeletonic-animations.css",
    "dev:prettier:animations": "npx prettier --write \"dist/css/animations/skeletonic-animations.css\" && stylelint \"dist/css/animations/skeletonic-animations.css\" --fix",
    "dev:autoprefixer:animations": "postcss --use autoprefixer --verbose --no-map.inline dist/css/animations/skeletonic-animations.css -r",
    "dev:minimize:animations": "find dist/css/animations/ -iname '*.css' -and -not -iname '*.min.css' -exec sh -c 'npx csso {} --stat --output ${0%.css}.min.css' {} \\;",
    "dev:filesizes:animations": "filesizes dist/css/animations/ > dist/css/animations/skeletonic-animations-report.txt",
    "// Skeletonic CSS Fonts": " --- Development Scripts --- ",
    "dev:generate:fonts": "pnpm run dev:format:fonts && pnpm run dev:create:fonts && pnpm run dev:prettier:fonts && pnpm run dev:autoprefixer:fonts && pnpm run dev:minimize:fonts && pnpm run dev:filesizes:fonts",
    "dev:format:fonts": "mkdir -p debug && npx stylus-supremacy format ./src/stylus/fonts/open-sans.styl --options .stylelintrc.json > ./debug/fonts-output.log",
    "dev:lint:fonts": "npx stylint ./src/stylus/fonts/open-sans.styl --strict --fix",
    "dev:create:fonts": "npx stylus ./src/stylus/fonts/open-sans.styl -o ./dist/css/fonts/skeletonic-fonts.css",
    "dev:prettier:fonts": "npx prettier --write \"dist/css/fonts/skeletonic-fonts.css\" && stylelint \"dist/css/fonts/skeletonic-fonts.css\" --fix",
    "dev:autoprefixer:fonts": "postcss --use autoprefixer --verbose --no-map.inline dist/css/fonts/skeletonic-fonts.css -r",
    "dev:minimize:fonts": "find dist/css/fonts/ -iname '*.css' -and -not -iname '*.min.css' -exec sh -c 'npx csso {} --stat --output ${0%.css}.min.css' {} \\;",
    "dev:filesizes:fonts": "filesizes dist/css/fonts/ > dist/css/fonts/skeletonic-fonts-report.txt",
    "// Skeletonic CSS Hebrew Fonts": " --- Development Scripts --- ",
    "dev:generate:hebrew-fonts": "pnpm run dev:format:hebrew-fonts && pnpm run dev:create:hebrew-fonts && pnpm run dev:prettier:hebrew-fonts && pnpm run dev:autoprefixer:hebrew-fonts && pnpm run dev:minimize:hebrew-fonts && pnpm run dev:filesizes:hebrew-fonts",
    "dev:format:hebrew-fonts": "mkdir -p debug && npx stylus-supremacy format ./src/stylus/hebrew-fonts/open-sans-hebrew.styl --options .stylelintrc.json > ./debug/hebrew-fonts-output.log",
    "dev:lint:hebrew-fonts": "npx stylint ./src/stylus/hebrew-fonts/open-sans-hebrew.styl --strict --fix",
    "dev:create:hebrew-fonts": "stylus ./src/stylus/hebrew-fonts/open-sans-hebrew.styl -o ./dist/css/hebrew-fonts/skeletonic-hebrew-fonts.css",
    "dev:prettier:hebrew-fonts": "npx prettier --write \"dist/css/hebrew-fonts/skeletonic-hebrew-fonts.css\" && stylelint \"dist/css/hebrew-fonts/skeletonic-hebrew-fonts.css\" --fix",
    "dev:autoprefixer:hebrew-fonts": "postcss --use autoprefixer --verbose --no-map.inline dist/css/hebrew-fonts/skeletonic-hebrew-fonts.css -r",
    "dev:minimize:hebrew-fonts": "find dist/css/hebrew-fonts/ -iname '*.css' -and -not -iname '*.min.css' -exec sh -c 'npx csso {} --stat --output ${0%.css}.min.css' {} \\;",
    "dev:filesizes:hebrew-fonts": "filesizes dist/css/hebrew-fonts/ > dist/css/hebrew-fonts/skeletonic-hebrew-fonts-report.txt",
    "// Skeletonic CSS Material Colors": " --- Development Scripts --- ",
    "dev:generate:material": "pnpm run dev:format:material && pnpm run dev:create:material && pnpm run dev:prettier:material && pnpm run dev:autoprefixer:material && pnpm run dev:minimize:material && pnpm run dev:filesizes:material",
    "dev:format:material": "mkdir -p debug && npx stylus-supremacy format ./src/stylus/palettes/material.styl --options .stylelintrc.json > ./debug/material-output.log",
    "dev:lint:material": "npx stylint ./src/stylus/palettes/material.styl --strict --fix",
    "dev:create:material": "stylus ./src/stylus/palettes/material.styl -o ./dist/css/palettes/material/skeletonic-material.css",
    "dev:prettier:material": "npx prettier --write \"dist/css/palettes/material/skeletonic-material.css\" && stylelint \"dist/css/palettes/material/skeletonic-material.css\" --fix",
    "dev:autoprefixer:material": "postcss --use autoprefixer --verbose --no-map.inline dist/css/palettes/material/skeletonic-material.css -r",
    "dev:minimize:material": "find dist/css/palettes/material/ -iname '*.css' -and -not -iname '*.min.css' -exec sh -c 'npx csso {} --stat --output ${0%.css}.min.css' {} \\;",
    "dev:filesizes:material": "filesizes dist/css/palettes/material/ > dist/css/palettes/material/skeletonic-material-report.txt",
    "// Skeletonic CSS Tachyons Colors": " --- Development Scripts --- ",
    "dev:generate:tachyons": "pnpm run dev:format:tachyons && pnpm run dev:create:tachyons && pnpm run dev:prettier:tachyons && pnpm run dev:autoprefixer:tachyons && pnpm run dev:minimize:tachyons && pnpm run dev:filesizes:tachyons",
    "dev:format:tachyons": "mkdir -p debug && npx stylus-supremacy format ./src/stylus/palettes/tachyons.styl --options .stylelintrc.json > ./debug/tachyons-output.log",
    "dev:lint:tachyons": "npx stylint ./src/stylus/palettes/tachyons.styl --strict --fix",
    "dev:create:tachyons": "stylus ./src/stylus/palettes/tachyons.styl -o ./dist/css/palettes/tachyons/skeletonic-tachyons.css",
    "dev:prettier:tachyons": "npx prettier --write \"dist/css/palettes/tachyons/skeletonic-tachyons.css\" && stylelint \"dist/css/palettes/tachyons/skeletonic-tachyons.css\" --fix",
    "dev:autoprefixer:tachyons": "postcss --use autoprefixer --verbose --no-map.inline dist/css/palettes/tachyons/skeletonic-tachyons.css -r",
    "dev:minimize:tachyons": "find dist/css/palettes/tachyons/ -iname '*.css' -and -not -iname '*.min.css' -exec sh -c 'npx csso {} --stat --output ${0%.css}.min.css' {} \\;",
    "dev:filesizes:tachyons": "filesizes dist/css/palettes/tachyons/ > dist/css/palettes/tachyons/skeletonic-tachyons-report.txt",
    "// Skeletonic CSS Websafe Colors": " --- Development Scripts --- ",
    "dev:generate:websafe": "pnpm run dev:format:websafe && pnpm run dev:create:websafe && pnpm run dev:prettier:websafe && pnpm run dev:autoprefixer:websafe && pnpm run dev:minimize:websafe && pnpm run dev:filesizes:websafe",
    "dev:format:websafe": "mkdir -p debug && npx stylus-supremacy format ./src/stylus/palettes/websafe.styl --options .stylelintrc.json > ./debug/websafe-output.log",
    "dev:lint:websafe": "npx stylint ./src/stylus/palettes/websafe.styl --strict --fix",
    "dev:create:websafe": "stylus ./src/stylus/palettes/websafe.styl -o ./dist/css/palettes/websafe/skeletonic-websafe.css",
    "dev:prettier:websafe": "npx prettier --write \"dist/css/palettes/websafe/skeletonic-websafe.css\" && stylelint \"dist/css/palettes/websafe/skeletonic-websafe.css\" --fix",
    "dev:autoprefixer:websafe": "postcss --use autoprefixer --verbose --no-map.inline dist/css/palettes/websafe/skeletonic-websafe.css -r",
    "dev:minimize:websafe": "find dist/css/palettes/websafe/ -iname '*.css' -and -not -iname '*.min.css' -exec sh -c 'npx csso {} --stat --output ${0%.css}.min.css' {} \\;",
    "dev:filesizes:websafe": "filesizes dist/css/palettes/websafe/ > dist/css/palettes/websafe/skeletonic-websafe-report.txt",
    "// Skeletonic CSS Core": " --- Development Scripts --- ",
    "dev:generate:skeletonic": "pnpm run dev:format:skeletonic && pnpm run dev:create:skeletonic && pnpm run dev:prettier:skeletonic && pnpm run dev:autoprefixer:skeletonic && pnpm run dev:minimize:skeletonic && pnpm run dev:filesizes:skeletonic",
    "dev:format:skeletonic": "mkdir -p debug/core && npx stylus-supremacy format ./src/stylus/skeletonic.styl --options .stylelintrc.json > ./debug/core/skeletonic-output.log",
    "dev:lint:skeletonic": "npx stylint ./src/stylus/skeletonic.styl --strict --fix",
    "dev:lint:stylus": "npx stylint src/stylus",
    "dev:create:skeletonic": "stylus ./src/stylus/skeletonic.styl -o ./dist/css/core/skeletonic.css",
    "dev:prettier:skeletonic": "npx prettier --write \"dist/css/core/skeletonic.css\" && stylelint \"dist/css/core/skeletonic.css\" --fix",
    "dev:autoprefixer:skeletonic": "postcss --use autoprefixer --verbose --no-map.inline dist/css/core/skeletonic.css -r",
    "dev:minimize:skeletonic": "find dist/css/core/ -iname '*.css' -and -not -iname '*.min.css' -exec sh -c 'npx csso {} --stat --output ${0%.css}.min.css' {} \\;",
    "dev:filesizes:skeletonic": "filesizes dist/css/core/ > dist/css/core/skeletonic-report.txt",
    "// Skeletonic CSS UI Addon": " --- Development Scripts --- ",
    "dev:generate:skeletonic-ui": "pnpm run dev:format:skeletonic-ui && pnpm run dev:create:skeletonic-ui && pnpm run dev:prettier:skeletonic-ui && pnpm run dev:autoprefixer:skeletonic-ui && pnpm run dev:minimize:skeletonic-ui && pnpm run dev:filesizes:skeletonic-ui",
    "dev:format:skeletonic-ui": "mkdir -p debug/core && npx stylus-supremacy format ./src/stylus/skeletonic-ui.styl --options .stylelintrc.json > ./debug/core/skeletonic-ui-output.log",
    "dev:lint:skeletonic-ui": "npx stylint ./src/stylus/skeletonic-ui.styl --strict --fix",
    "dev:create:skeletonic-ui": "stylus ./src/stylus/skeletonic-ui.styl -o ./dist/css/core/skeletonic-ui.css",
    "dev:prettier:skeletonic-ui": "npx prettier --write \"dist/css/core/skeletonic-ui.css\" && stylelint \"dist/css/core/skeletonic-ui.css\" --fix",
    "dev:autoprefixer:skeletonic-ui": "postcss --use autoprefixer --verbose --no-map.inline dist/css/core/skeletonic-ui.css -r",
    "dev:minimize:skeletonic-ui": "find dist/css/core/ -iname 'skeletonic-ui.css' -exec sh -c 'npx csso {} --stat --output ${0%.css}.min.css' {} \\;",
    "dev:filesizes:skeletonic-ui": "filesizes dist/css/core/ > dist/css/core/skeletonic-ui-report.txt",
    "// Skeletonic CSS Maintenance": " --- Development Scripts --- ",
    "dev:clean:directory": "rimraf dist debug",
    "dev:copy:readme": "cp README.md dist/",
    "dev:copy:index": "cp index.html dist/",
    "dev:copy:stylus": "cp -R src/stylus dist/",
    "dev:copy:cli": "mkdir -p dist/scripts && cp scripts/cli.mjs dist/scripts/cli.mjs && chmod +x dist/scripts/cli.mjs",
    "dev:filesizes:package": "filesizes dist/ > dist/filesize-report.txt",
    "dev:format": "npx prettier --write \"*.md\" \"src/**/*.md\"",
    "// Production": " --- Production Scripts --- ",
    "test": "pnpm run dev:lint:stylus"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@sebastienrousseau/markdownlint-config": "^0.0.1",
    "@sebastienrousseau/prettier-config": "^0.0.4",
    "@sebastienrousseau/remark-config": "^0.0.3",
    "@size-limit/file": "^12.1.0",
    "autoprefixer": "^10.5.0",
    "clean-css-cli": "^5.6.3",
    "csso-cli": "^4.0.2",
    "filesizes": "^0.1.2",
    "playwright": "^1.59.1",
    "postcss": "^8.5.13",
    "postcss-cli": "^11.0.1",
    "postcss-sorting": "^10.0.0",
    "prettier": "^3.8.3",
    "remark-cli": "^12.0.1",
    "remark-footnotes": "^5.0.0",
    "remark-preset-lint-consistent": "^6.0.1",
    "remark-preset-lint-markdown-style-guide": "^6.0.1",
    "remark-preset-lint-recommended": "^7.0.1",
    "rimraf": "^6.1.3",
    "size-limit": "^12.1.0",
    "stylelint": "^17.9.1",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-high-performance-animation": "^2.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-prettier": "^5.0.3",
    "stylint": "^2.0.0",
    "stylus": "^0.64.0",
    "stylus-supremacy": "^5.0.1"
  },
  "pnpm": {
    "overrides": {
      "lodash@<4.18.0": ">=4.18.0",
      "minimatch@<3.1.3": ">=3.1.3",
      "minimatch@>=5.0.0 <5.1.8": ">=5.1.8",
      "minimatch@>=7.0.0 <7.4.8": ">=7.4.8",
      "minimatch@>=8.0.0 <8.0.6": ">=8.0.6",
      "minimatch@>=9.0.0 <9.0.7": ">=9.0.7",
      "picomatch@<2.3.2": ">=2.3.2",
      "flatted@<3.4.2": ">=3.4.2",
      "js-yaml@<3.14.2": ">=3.14.2",
      "js-yaml@>=4.0.0 <4.1.1": ">=4.1.1",
      "braces@<3.0.3": ">=3.0.3",
      "postcss@<8.4.31": ">=8.4.31",
      "mout@<=1.2.4": ">=1.2.4",
      "yargs-parser@<=5.0.0": ">=5.0.1"
    }
  }
}
